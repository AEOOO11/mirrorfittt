              <div>
                <div style="font-size:13.5px; font-weight:800; color:var(--text-main);">📍 직거래 추천 장소</div>
                <div style="font-size:11px; color:var(--text-muted); margin-top:1px;">안산대학교 · 경기도 안산시 상록구</div>
              </div>
              <a href="https://map.naver.com/p/search/%EC%95%88%EC%82%B0%EB%8C%80%ED%95%99%EA%B5%90/place/31599329" target="_blank" rel="noopener noreferrer"
                style="margin-left:auto; font-size:11px; font-weight:700; color:var(--primary-mint-dark); background:var(--primary-mint-light); padding:4px 10px; border-radius:20px; text-decoration:none; white-space:nowrap;">
                지도 열기 ↗
              </a>
            </div>

            <!-- 지도 영역 (클릭 시 네이버 지도 이동) -->
            <a href="https://map.naver.com/p/search/%EC%95%88%EC%82%B0%EB%8C%80%ED%95%99%EA%B5%90/place/31599329"
               target="_blank" rel="noopener noreferrer"
               id="naverMapLink"
               style="display:block; position:relative; width:100%; height:200px; overflow:hidden; cursor:pointer; text-decoration:none;">
              <!-- 안산대학교 지도 이미지 -->
              <img
                src="ansan-map.jpg"
                alt="안산대학교 위치 지도"
                style="width:100%; height:100%; object-fit:cover; object-position:center; display:block;"
                loading="lazy"
              />
              <!-- 클릭 오버레이 (iframe 클릭 차단 방지용) -->
              <div style="position:absolute; inset:0; z-index:10; background:transparent;"></div>
              <!-- 네이버 지도 배지 -->
              <div style="position:absolute; bottom:10px; right:10px; z-index:11; background:rgba(255,255,255,0.95); border-radius:8px; padding:5px 10px; display:flex; align-items:center; gap:5px; box-shadow:0 2px 8px rgba(0,0,0,0.15);">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#03c75a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                  <circle cx="12" cy="9" r="2.5"/>
                </svg>
                <span style="font-size:11px; font-weight:800; color:#03c75a;">NAVER 지도로 보기</span>
              </div>
            </a>

            <!-- 장소 정보 푸터 -->
            <div style="padding:11px 16px; display:flex; flex-direction:column; gap:5px;">
              <div style="display:flex; align-items:center; gap:7px;">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                  <circle cx="12" cy="9" r="2.5"/>
                </svg>
                <span style="font-size:12px; color:var(--text-sub);">경기도 안산시 상록구 안산대학로 155</span>
              </div>
              <div style="display:flex; align-items:center; gap:7px;">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
                <span style="font-size:12px; color:var(--text-sub);">직거래 가능 시간: 평일 09:00 – 18:00</span>
              </div>
              <div style="margin-top:4px; display:flex; gap:6px;">
                <span style="font-size:10.5px; font-weight:700; background:#e8f9f5; color:var(--primary-mint-dark); padding:3px 8px; border-radius:20px;">🏫 대학교</span>
                <span style="font-size:10.5px; font-weight:700; background:#f0f7ff; color:#2b7fff; padding:3px 8px; border-radius:20px;">🤝 직거래 안전지대</span>
                <span style="font-size:10.5px; font-weight:700; background:#fff4e8; color:#f07d00; padding:3px 8px; border-radius:20px;">🚌 대중교통 편리</span>
              </div>
            </div>
          </div>
          <!-- ======== /직거래 장소 지도 카드 ======== -->

        </div>
      </section>

    </div><!-- /screen-viewport -->

    <!-- ========================================================
         하단 고정 네비게이션 탭바 (고품질 프리미엄 듀오톤 벡터 아이콘)
         ======================================================== -->
    <nav class="nav-tab-bar" id="bottomNavBar" style="display:none;">
      <button class="tab-item active" data-nav="screen-home">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9.5L12 3l9 6.5V20a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9.5z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span>Home</span>
      </button>

      <button class="tab-item" data-nav="screen-report-detail">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
          <rect x="8" y="2" width="8" height="4" rx="1.5" ry="1.5"/>
          <path d="M9 14l2 2 4-4"/>
          <line x1="8" y1="10" x2="16" y2="10"/>
        </svg>
        <span>Report</span>
      </button>

      <button class="tab-item" data-nav="screen-styling">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span>Shop</span>
      </button>

      <button class="tab-item" data-nav="screen-market">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
          <circle cx="7" cy="7" r="1.5" fill="currentColor"/>
          <path d="M16 7l2 2-2 2"/>
        </svg>
        <span>Market</span>
      </button>

      <button class="tab-item" data-nav="screen-posture">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="4.5" r="2.5"/>
          <path d="M12 7.5v6"/>
          <path d="M5 11c2.5-1.5 5-1.8 7-1.8s4.5.3 7 1.8"/>
          <path d="M8 21.5l4-8 4 8"/>
        </svg>
        <span>Posture</span>
      </button>
    </nav>

    <!-- PC 전용 하단 인디케이터 바 -->
    <div class="phone-chin"></div>

  </div><!-- /app-container -->

  <!-- 중고거래 모달 -->
  <div class="modal-overlay" id="marketModal">
    <div class="modal-popup">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
        <span class="brand-logo-badge" style="margin:0;">🎯 AI 체형 100% 매칭</span>
        <button id="btnCloseMarketModal" style="background:none; border:none; font-size:24px; cursor:pointer; color:var(--text-muted);">&times;</button>
      </div>
      <!-- 실제 상품 화보/실물 사진 -->
      <div style="width:100%; height:160px; border-radius:14px; overflow:hidden; margin-bottom:12px; background:#f0f4f3; position:relative; cursor:pointer;" id="modalMImgWrap" title="상품 공식몰 페이지 보기">
        <img id="modalMImg" src="" alt="중고의류 상품" referrerpolicy="no-referrer" style="width:100%; height:100%; object-fit:cover;">
        <span id="modalMUrlBadge" style="display:none; position:absolute; bottom:6px; right:8px; background:rgba(0,0,0,0.78); color:#fff; font-size:10px; font-weight:700; padding:3px 8px; border-radius:6px; backdrop-filter:blur(4px);">공식몰 바로가기 ↗</span>
      </div>
      <h3 id="modalMTitle" style="font-size:17px; font-weight:800; margin-bottom:4px;">자라 클래식 테일러드 자켓</h3>
      <p id="modalMPrice" style="font-size:19px; font-weight:800; color:var(--primary-mint-dark); margin-bottom:12px;">₩42,000</p>
      <div style="background:var(--primary-mint-soft); padding:10px 12px; border-radius:10px; font-size:12.5px; color:var(--text-sub); margin-bottom:16px; border:1px solid var(--border-mint);">
        💡 <strong>AI 피팅 보증 코멘트:</strong><br>
        "판매자님과 동일한 체형으로, 어깨 라인과 슬랙스 핏이 최적화되어 슬림하고 우아한 실루엣을 완성합니다."
      </div>
      <div style="display:flex; gap:8px;">
        <button class="btn-secondary" id="btnChatModal">1:1 피팅 문의 채팅</button>
        <button class="btn-primary" id="btnBuyModal">안전 결제하기</button>
      </div>
    </div>
  </div>

  <!-- 스트레칭 타이머 모달 -->
  <div class="modal-overlay" id="timerModal">
    <div class="modal-popup" style="text-align:center;">
      <h3 style="font-size:18px; font-weight:800;">스트레칭 진행 중</h3>
      <p style="font-size:13px; color:var(--text-sub); margin-top:4px;">어깨를 바르게 펴고 편안히 호흡하세요</p>
      <div style="font-size:52px; font-weight:900; color:var(--primary-mint-dark); margin:18px 0;" id="timerDisplay">30s</div>
      <button class="btn-primary" id="btnFinishTimer">스트레칭 완료</button>
    </div>
  </div>

  <!-- ========================================================
       자바스크립트 로직 (단일 파일 완전 내장)
       ======================================================== -->
  <script>
    (function() {
      // 1. 상태 객체
      const state = {
        userName: '미러핏',
        bodyType: '스트레이트',
        height: 165,
        weight: 55,
        currentAngle: 'front', // 'front' | 'left' | 'right'
        capturedPhotos: {
          front: null,
          left: null,
          right: null
        },
        capturedPhoto: null,
        cameraStream: null,
        history: []
      };

      // 2. 시계
      function updateClock() {
        const el = document.getElementById('systemClock');
        if (!el) return;
        const now = new Date();
        el.textContent = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
      }
      updateClock();
      setInterval(updateClock, 10000);

      // PC 모드 토글
      const viewModeToggle = document.getElementById('viewModeToggle');
      if (viewModeToggle) {
        viewModeToggle.addEventListener('click', function() {
          document.body.classList.toggle('full-mode');
          const isFull = document.body.classList.contains('full-mode');
          viewModeToggle.querySelector('span').textContent = isFull ? '모바일 프레임 모드' : '전체 화면 모드';
        });
      }

      // 3. 화면 라우팅
      const screens = document.querySelectorAll('.screen');
      const bottomNavBar = document.getElementById('bottomNavBar');
      const tabItems = document.querySelectorAll('.tab-item');

      function showScreen(id, pushHistory = true) {
        const cur = document.querySelector('.screen.active');
        if (cur && pushHistory && cur.id !== id) {
          state.history.push(cur.id);
        }

        // 카메라 화면을 벗어날 때 스트림 정리
        if (cur && cur.id === 'screen-capture' && id !== 'screen-capture') {
          stopCameraStream();
        }

        screens.forEach(s => s.classList.remove('active'));
        const target = document.getElementById(id);
        if (target) {
          target.classList.add('active');
          target.scrollTop = 0;
        }

        // 다크 화면(카메라 촬영 등) 진입 시 상태바 아이콘/시계 화이트 반전 처리
        const statusBarEl = document.getElementById('appStatusBar');
        if (statusBarEl) {
          if (id === 'screen-capture') {
            statusBarEl.classList.add('text-white');
          } else {
            statusBarEl.classList.remove('text-white');
          }
        }

        // 카메라 화면 진입 시 현재 각도에 맞춰 3방향 UI 및 카메라 동기화
        if (id === 'screen-capture') {
          if (typeof switchCaptureAngle === 'function') {
            switchCaptureAngle(state.currentAngle || 'front');
          } else {
            startCameraStream();
          }
        }

        const subScreens = ['screen-home', 'screen-report-detail', 'screen-posture', 'screen-styling', 'screen-market'];
        if (subScreens.includes(id)) {
          bottomNavBar.style.display = 'flex';
          tabItems.forEach(t => {
            if (t.getAttribute('data-nav') === id) t.classList.add('active');
            else t.classList.remove('active');
          });
        } else {
          bottomNavBar.style.display = 'none';
        }
      }

      function goBack() {
        if (state.history.length > 0) {
          showScreen(state.history.pop(), false);
        } else {
          showScreen('screen-home', false);
        }
      }

      // 탭 네비 클릭
      tabItems.forEach(t => {
        t.addEventListener('click', function() {
          const navId = t.getAttribute('data-nav');
          if (navId) showScreen(navId);
        });
      });

      // [Step 1] 온보딩
      document.getElementById('btnStartOnboarding').addEventListener('click', function() {
        showScreen('screen-login');
      });

      // [Step 2-1] 로그인
      function doLogin() {
        const nameVal = document.getElementById('userNameInput').value.trim();
        if (nameVal) state.userName = nameVal;
        document.getElementById('homeUserName').textContent = state.userName;
        showScreen('screen-guide');
      }
      document.getElementById('btnLoginSubmit').addEventListener('click', doLogin);
      document.getElementById('btnKakaoLogin').addEventListener('click', doLogin);
      document.getElementById('btnNaverLogin').addEventListener('click', doLogin);
      document.getElementById('btnBackToLogin').addEventListener('click', function() {
        showScreen('screen-login', false);
      });

      // [Step 2-2] 체형 가이드 탭
      const tabBtns = document.querySelectorAll('.body-tab-btn');
      const cards = document.querySelectorAll('.body-type-card');
      tabBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const key = btn.getAttribute('data-tab');
          tabBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          cards.forEach(c => {
            c.classList.remove('active');
            if (c.id === `tab-${key}`) c.classList.add('active');
          });
        });
      });
      document.getElementById('btnStartCapture').addEventListener('click', function() {
        showScreen('screen-photo-guide');
      });

      // ========================================================
      // [Step 2-5] 촬영 가이드 화면 버튼 연결
      // ========================================================
      document.getElementById('btnBackFromPhotoGuide').addEventListener('click', function() {
        showScreen('screen-guide', false);
      });
      document.getElementById('btnGoToCapture').addEventListener('click', function() {
        showScreen('screen-capture');
      });

      // ========================================================
      // [Step 3] AI 3방향 사진 촬영 (전신 정면, 좌측면, 우측면) 로직
      // ========================================================
      document.getElementById('btnBackToGuide').addEventListener('click', function() {
        showScreen('screen-photo-guide', false);
      });

      const cameraCaptureInput = document.getElementById('cameraCaptureInput');
      const filePhotoInput = document.getElementById('filePhotoInput');
      const cameraLiveVideo = document.getElementById('cameraLiveVideo');
      const cameraCanvas = document.getElementById('cameraCanvas');
      const mediapipeOverlayCanvas = document.getElementById('mediapipeOverlayCanvas');
      const cameraPreviewImg = document.getElementById('cameraPreviewImg');
      const cameraStatusBadge = document.getElementById('cameraStatusBadge');
      const cameraStatusDot = document.getElementById('cameraStatusDot');
      const cameraStatusText = document.getElementById('cameraStatusText');
      const personDetectionAlertToast = document.getElementById('personDetectionAlertToast');
      const captureGuideNotice = document.getElementById('captureGuideNotice');
      const btnUploadGallery = document.getElementById('btnUploadGallery');
      const btnTriggerCapture = document.getElementById('btnTriggerCapture');
      const btnRetakePhotoDirect = document.getElementById('btnRetakePhotoDirect');
      const btnNextAngleOrAnalyze = document.getElementById('btnNextAngleOrAnalyze');
      const btnNextAngleText = document.getElementById('btnNextAngleText');
      const captureControlsBefore = document.getElementById('captureControlsBefore');
      const captureControlsAfter = document.getElementById('captureControlsAfter');

      // 3방향 탭 & 가이드 엘리먼트
      const tabAngleFront = document.getElementById('tabAngleFront');
      const tabAngleLeft = document.getElementById('tabAngleLeft');
      const tabAngleRight = document.getElementById('tabAngleRight');
      const thumbSlotFront = document.getElementById('thumbSlotFront');
      const thumbSlotLeft = document.getElementById('thumbSlotLeft');
      const thumbSlotRight = document.getElementById('thumbSlotRight');
      const thumbBoxFront = document.getElementById('thumbBoxFront');
      const thumbBoxLeft = document.getElementById('thumbBoxLeft');
      const thumbBoxRight = document.getElementById('thumbBoxRight');
      const guideSvgFront = document.getElementById('guideSvgFront');
      const guideSvgLeft = document.getElementById('guideSvgLeft');
      const guideSvgRight = document.getElementById('guideSvgRight');
      const pinNeck = document.getElementById('pinNeck');
      const pinShoulder = document.getElementById('pinShoulder');
      const pinWaist = document.getElementById('pinWaist');
      const pinArm = document.getElementById('pinArm');

      function getAngleLabel(angle) {
        if (angle === 'front') return '전신(정면)';
        if (angle === 'left') return '좌측면';
        return '우측면';
      }

      // 각도 전환 함수
      function switchCaptureAngle(angle) {
        state.currentAngle = angle;

        // 탭 상태 업데이트
        [tabAngleFront, tabAngleLeft, tabAngleRight].forEach(tab => {
          if (tab) tab.classList.toggle('active', tab.dataset.angle === angle);
        });

        // 썸네일 슬롯 활성화 업데이트
        [thumbSlotFront, thumbSlotLeft, thumbSlotRight].forEach(slot => {
          if (slot) slot.classList.toggle('active', slot.dataset.angle === angle);
        });

        // 가이드 실루엣 표시 전환
        if (guideSvgFront) guideSvgFront.style.display = angle === 'front' ? 'block' : 'none';
        if (guideSvgLeft) guideSvgLeft.style.display = angle === 'left' ? 'block' : 'none';
        if (guideSvgRight) guideSvgRight.style.display = angle === 'right' ? 'block' : 'none';

        // 각도별 안내 문구 & 핀 버블
        if (angle === 'front') {
          if (captureGuideNotice) captureGuideNotice.textContent = '정면을 응시하고 양팔을 가볍게 벌려 바른 자세로 서주세요.';
          if (pinNeck) pinNeck.textContent = '목 둘레, 목 길이';
          if (pinShoulder) pinShoulder.textContent = '어깨 너비';
          if (pinWaist) pinWaist.textContent = '허리 라인';
          if (pinArm) pinArm.textContent = '골격 중심선';
        } else if (angle === 'left') {
          if (captureGuideNotice) captureGuideNotice.textContent = '왼쪽으로 90° 회전하여 측면 실루엣이 보이도록 서주세요.';
          if (pinNeck) pinNeck.textContent = '거북목 각도';
          if (pinShoulder) pinShoulder.textContent = '라운드숄더';
          if (pinWaist) pinWaist.textContent = '척추 S라인 곡선';
          if (pinArm) pinArm.textContent = '골반 전방경사';
        } else {
          if (captureGuideNotice) captureGuideNotice.textContent = '오른쪽으로 90° 회전하여 반대편 측면 실루엣을 맞춰주세요.';
          if (pinNeck) pinNeck.textContent = '경추 정렬 상태';
          if (pinShoulder) pinShoulder.textContent = '등 굽음도 (흉추)';
          if (pinWaist) pinWaist.textContent = '흉곽 & 허리 각도';
          if (pinArm) pinArm.textContent = '골반 수평축 & 무릎';
        }

        // 해당 각도에 사진이 이미 있는 경우 프리뷰 및 확인 모드
        const currentData = state.capturedPhotos[angle];
        if (currentData) {
          cameraPreviewImg.src = currentData;
          cameraPreviewImg.style.display = 'block';
          stopCameraStream();
          captureControlsBefore.style.display = 'none';
          captureControlsAfter.style.display = 'flex';
          updateCameraStatusBadge();
          updateNextButtonUI();
        } else {
          cameraPreviewImg.style.display = 'none';
          captureControlsBefore.style.display = 'flex';
          captureControlsAfter.style.display = 'none';
          updateCameraStatusBadge();
          startCameraStream();
        }
      }

      // 탭 & 슬롯 클릭 이벤트 연결
      if (tabAngleFront) tabAngleFront.addEventListener('click', () => switchCaptureAngle('front'));
      if (tabAngleLeft) tabAngleLeft.addEventListener('click', () => switchCaptureAngle('left'));
      if (tabAngleRight) tabAngleRight.addEventListener('click', () => switchCaptureAngle('right'));

      if (thumbSlotFront) thumbSlotFront.addEventListener('click', () => switchCaptureAngle('front'));
      if (thumbSlotLeft) thumbSlotLeft.addEventListener('click', () => switchCaptureAngle('left'));
      if (thumbSlotRight) thumbSlotRight.addEventListener('click', () => switchCaptureAngle('right'));

      // ========================================================
      // [MediaPipe Pose] 실시간 사람 신체 인식 시스템
      // ========================================================
      let mpPose = null;
      let isMediaPipeReady = false;
      let realtimePersonDetected = false;
      let lastRealtimeCheckTime = 0;
      let videoFrameAnimId = null;
      let pendingVerificationResolve = null;

      // 실패 알림 함수 (요구된 문구 정확 적용)
      function showPersonDetectionFailureAlert() {
        const failureMessage = "분석 실패: 사람이 인식되지 않았습니다. 전신이 화면에 나오도록 다시 촬영해 주세요.";

        // 시각적 토스트 알림창 표시
        if (personDetectionAlertToast) {
          personDetectionAlertToast.style.display = 'block';
          setTimeout(() => {
            personDetectionAlertToast.style.display = 'none';
          }, 4500);
        }

        // 상태 뱃지 경고 표시
        if (cameraStatusDot) {
          cameraStatusDot.style.background = '#e53935';
          cameraStatusDot.style.boxShadow = '0 0 10px #e53935';
        }
        if (cameraStatusText) {
          cameraStatusText.textContent = `❌ 신체 미인식 (전신을 맞춰주세요)`;
        }

        // 표준 alert 안내 메시지 즉시 호출
        alert(failureMessage);
      }

      // MediaPipe Pose 초기화 함수
      function initMediaPipePose() {
        if (typeof Pose !== 'undefined') {
          try {
            mpPose = new Pose({
              locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/pose/${file}`
            });
            mpPose.setOptions({
              modelComplexity: 0, // 모바일 실시간 처리 최적화
              smoothLandmarks: true,
              enableSegmentation: false,
              smoothSegmentation: false,
              minDetectionConfidence: 0.5,
              minTrackingConfidence: 0.5
            });
            mpPose.onResults(onPoseResults);
            isMediaPipeReady = true;
            console.log('[MediaPipe Pose] AI 신체 인식 모듈이 성공적으로 초기화되었습니다.');
          } catch (err) {
            console.warn('[MediaPipe Pose] 초기화 경고:', err);
          }
        }
      }

      // 페이지 로드 시 MediaPipe 초기화
      if (document.readyState === 'complete') {
        initMediaPipePose();
      } else {
        window.addEventListener('load', initMediaPipePose);
      }

      // 실시간 MediaPipe Pose 결과 핸들러
      function onPoseResults(results) {
        if (!results) return;

        const hasLandmarks = !!(results.poseLandmarks && results.poseLandmarks.length >= 11);
        let validPointsCount = 0;
        if (hasLandmarks) {
          results.poseLandmarks.forEach(pt => {
            if (pt.visibility === undefined || pt.visibility > 0.4) {
              validPointsCount++;
            }
          });
        }

        // 주요 랜드마크(머리, 어깨, 몸통, 다리 등)가 인식되었는지 확인
        realtimePersonDetected = hasLandmarks && validPointsCount >= 5;

        // 단일 이미지 검증 대기 중인 프로미스 처리
        if (pendingVerificationResolve) {
          const res = pendingVerificationResolve;
          pendingVerificationResolve = null;
          res(realtimePersonDetected);
        }

        // 랜드마크 스켈레톤 실시간 오버레이
        drawPoseSkeleton(results.poseLandmarks, realtimePersonDetected);

        // 상태 뱃지 업데이트
        updateCameraStatusBadge();
      }

      // 카메라 상태 뱃지 업데이트
      function updateCameraStatusBadge() {
        if (!cameraStatusBadge || !cameraStatusText || !cameraStatusDot) return;
        const angleName = getAngleLabel(state.currentAngle);

        if (state.capturedPhotos[state.currentAngle]) {
          cameraStatusDot.style.background = '#38c9b2';
          cameraStatusDot.style.boxShadow = '0 0 6px #38c9b2';
          cameraStatusText.textContent = `${angleName} 촬영 완료 (확인)`;
          return;
        }

        if (state.cameraStream) {
          if (realtimePersonDetected) {
            cameraStatusDot.style.background = '#2ecc71';
            cameraStatusDot.style.boxShadow = '0 0 8px #2ecc71';
            cameraStatusText.textContent = `LIVE: ${angleName} · 🟢 신체 인식 정상 (MediaPipe)`;
          } else {
            cameraStatusDot.style.background = '#f39c12';
            cameraStatusDot.style.boxShadow = '0 0 6px #f39c12';
            cameraStatusText.textContent = `LIVE: ${angleName} · 🟡 사람 인식 대기중 (전신을 맞춰주세요)`;
          }
        } else {
          cameraStatusDot.style.background = '#38c9b2';
          cameraStatusDot.style.boxShadow = '0 0 6px #38c9b2';
          cameraStatusText.textContent = `${angleName} 촬영 준비 (MediaPipe 인식 활성)`;
        }
      }

      // 실시간 인체 랜드마크 스켈레톤 시각화
      function drawPoseSkeleton(landmarks, isDetected) {
        if (!mediapipeOverlayCanvas) return;
        const ctx = mediapipeOverlayCanvas.getContext('2d');
        ctx.clearRect(0, 0, mediapipeOverlayCanvas.width, mediapipeOverlayCanvas.height);

        if (!landmarks || !isDetected) return;

        const w = mediapipeOverlayCanvas.width;
        const h = mediapipeOverlayCanvas.height;

        // 주요 연결 뼈대
        const connections = [
          [11, 12], [11, 13], [13, 15], [12, 14], [14, 16],
          [11, 23], [12, 24], [23, 24],
          [23, 25], [24, 26], [25, 27], [26, 28]
        ];

        ctx.strokeStyle = '#38c9b2';
        ctx.lineWidth = 2.5;
        ctx.lineCap = 'round';

        connections.forEach(([i, j]) => {
          const p1 = landmarks[i];
          const p2 = landmarks[j];
          if (p1 && p2 && (p1.visibility === undefined || p1.visibility > 0.4) && (p2.visibility === undefined || p2.visibility > 0.4)) {
            ctx.beginPath();
            ctx.moveTo(p1.x * w, p1.y * h);
            ctx.lineTo(p2.x * w, p2.y * h);
            ctx.stroke();
          }
        });

        // 랜드마크 포인트
        ctx.fillStyle = '#4fe0c8';
        landmarks.forEach((p, idx) => {
          if (idx <= 28 && (p.visibility === undefined || p.visibility > 0.4)) {
            ctx.beginPath();
            ctx.arc(p.x * w, p.y * h, 3.5, 0, 2 * Math.PI);
            ctx.fill();
          }
        });
      }

      // 지능형 컴퓨터 비전 분석기 (MediaPipe 폴백 및 고정밀 보조 검증)
      function fallbackAnalyzePerson(source) {
        try {
          if (typeof source === 'string' && source.includes('data:image/svg+xml')) {
            return true;
          }

          const canvas = document.createElement('canvas');
          canvas.width = 160;
          canvas.height = 240;
          const ctx = canvas.getContext('2d');
          if (!ctx) return true;

          if (source instanceof HTMLCanvasElement || source instanceof HTMLImageElement || source instanceof HTMLVideoElement) {
            ctx.drawImage(source, 0, 0, 160, 240);
          } else if (source && source.src) {
            ctx.drawImage(source, 0, 0, 160, 240);
          } else {
            return false;
          }

          const imgData = ctx.getImageData(0, 0, 160, 240);
          const data = imgData.data;

          let nonBlackCount = 0;
          let skinToneCount = 0;
          const sampledBrightness = [];

          for (let y = 36; y < 204; y += 4) {
            for (let x = 32; x < 128; x += 4) {
              const idx = (y * 160 + x) * 4;
              const r = data[idx];
              const g = data[idx + 1];
              const b = data[idx + 2];
              const a = data[idx + 3];

              if (a > 50) {
                const brightness = (r + g + b) / 3;
                if (brightness > 20 && brightness < 245) {
                  nonBlackCount++;
                  sampledBrightness.push(brightness);

                  const isSkin = (r > 60 && g > 40 && b > 25 && r > g && r > b && (r - g) >= 8);
                  if (isSkin) skinToneCount++;
                }
              }
            }
          }

          if (sampledBrightness.length < 50) {
            return false;
          }

          // 픽셀 밝기 분산 계산 (단색 배경, 카메라 가림 차단)
          const avg = sampledBrightness.reduce((a, b) => a + b, 0) / sampledBrightness.length;
          let varianceSum = 0;
          for (let i = 0; i < sampledBrightness.length; i++) {
            varianceSum += Math.pow(sampledBrightness[i] - avg, 2);
          }
          const variance = Math.sqrt(varianceSum / sampledBrightness.length);

          // 분산이 12 미만이면 단색 벽지/바닥이거나 렌즈 가림 (사람 없음)
          if (variance < 12) {
            return false;
          }

          return nonBlackCount > 80 && (skinToneCount >= 2 || variance >= 18);
        } catch (e) {
          console.warn('fallbackAnalyzePerson 오류:', e);
          return false;
        }
      }

      // 실시간 비디오 프레임 폴백 검사
      function fallbackCheckVideoFrame(video) {
        try {
          if (!video || video.videoWidth === 0) return false;
          return fallbackAnalyzePerson(video);
        } catch (e) {
          return false;
        }
      }

      // 사진 촬영 시 사람 신체 인식 정밀 검증
      function verifyPersonImage(imageSource) {
        return new Promise((resolve) => {
          // 1) SVG 예시 모델 사진
          if (typeof imageSource === 'string' && imageSource.includes('data:image/svg+xml')) {
            resolve(true);
            return;
          }
          if (imageSource instanceof HTMLImageElement && imageSource.src && imageSource.src.includes('data:image/svg+xml')) {
            resolve(true);
            return;
          }

          // 2) MediaPipe Pose가 준비되어 있는 경우
          if (isMediaPipeReady && mpPose) {
            let isDone = false;
            const timeoutTimer = setTimeout(() => {
              if (!isDone) {
                isDone = true;
                pendingVerificationResolve = null;
                resolve(fallbackAnalyzePerson(imageSource));
              }
            }, 1200);

            pendingVerificationResolve = (detectedByPose) => {
              if (!isDone) {
                isDone = true;
                clearTimeout(timeoutTimer);
                if (detectedByPose) {
                  resolve(true);
                } else {
                  // Pose 감지가 미흡했을 때 2차 폴백 분석
                  resolve(fallbackAnalyzePerson(imageSource));
                }
              }
            };

            try {
              mpPose.send({ image: imageSource }).catch(() => {
                if (!isDone) {
                  isDone = true;
                  clearTimeout(timeoutTimer);
                  pendingVerificationResolve = null;
                  resolve(fallbackAnalyzePerson(imageSource));
                }
              });
            } catch (err) {
              if (!isDone) {
                isDone = true;
                clearTimeout(timeoutTimer);
                pendingVerificationResolve = null;
                resolve(fallbackAnalyzePerson(imageSource));
              }
            }
          } else {
            // 3) MediaPipe 미준비 시 지능형 컴퓨터 비전 분석기 실행
            resolve(fallbackAnalyzePerson(imageSource));
          }
        });
      }

      // 캡처 데이터 검증 후 통과 시에만 적용하는 핵심 함수
      async function handleCapturedDataUrl(dataUrl) {
        if (!dataUrl) {
          showPersonDetectionFailureAlert();
          return;
        }

        if (cameraStatusText) {
          cameraStatusText.textContent = `MediaPipe 신체 인식 검증 중...`;
        }

        const img = new Image();
        img.crossOrigin = 'anonymous';
        img.onload = async function() {
          try {
            const isDetected = await verifyPersonImage(img);
            if (!isDetected) {
              // 사람 미인식 시 촬영을 완료하지 않고 즉시 분석 실패 안내 표시!
              showPersonDetectionFailureAlert();
              updateCameraStatusBadge();
              return;
            }
            // 사람 인식 정상 통과 시에만 촬영 완료 처리!
            applyCapturedPhoto(dataUrl);
          } catch (e) {
            console.warn('검증 처리 중 오류:', e);
            showPersonDetectionFailureAlert();
          }
        };
        img.onerror = function() {
          showPersonDetectionFailureAlert();
        };
        img.src = dataUrl;
      }

      // 실시간 카메라 비디오 분석 루프
      function processLiveVideoFrame() {
        if (!state.cameraStream || !cameraLiveVideo || cameraLiveVideo.paused || cameraLiveVideo.ended) {
          return;
        }

        const now = Date.now();
        if (now - lastRealtimeCheckTime > 180) {
          lastRealtimeCheckTime = now;
          if (cameraLiveVideo.videoWidth > 0 && cameraLiveVideo.videoHeight > 0) {
            if (mediapipeOverlayCanvas) {
              if (mediapipeOverlayCanvas.width !== cameraLiveVideo.videoWidth || mediapipeOverlayCanvas.height !== cameraLiveVideo.videoHeight) {
                mediapipeOverlayCanvas.width = cameraLiveVideo.videoWidth;
                mediapipeOverlayCanvas.height = cameraLiveVideo.videoHeight;
              }
            }

            if (isMediaPipeReady && mpPose && !pendingVerificationResolve) {
              try {
                mpPose.send({ image: cameraLiveVideo }).catch(() => {});
              } catch (e) {}
            } else if (!isMediaPipeReady) {
              realtimePersonDetected = fallbackCheckVideoFrame(cameraLiveVideo);
              updateCameraStatusBadge();
            }
          }
        }

        videoFrameAnimId = requestAnimationFrame(processLiveVideoFrame);
      }

      // 웹캠 / 디바이스 라이브 비디오 스트림 시도
      function startCameraStream() {
        if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
          navigator.mediaDevices.getUserMedia({
            video: { facingMode: { ideal: 'environment' }, width: { ideal: 720 }, height: { ideal: 1280 } }
          }).then(function(stream) {
            state.cameraStream = stream;
            cameraLiveVideo.srcObject = stream;
            cameraLiveVideo.style.display = 'block';
            cameraPreviewImg.style.display = 'none';
            if (mediapipeOverlayCanvas) mediapipeOverlayCanvas.style.display = 'block';

            cameraLiveVideo.onloadedmetadata = () => {
              cameraLiveVideo.play();
              if (videoFrameAnimId) cancelAnimationFrame(videoFrameAnimId);
              videoFrameAnimId = requestAnimationFrame(processLiveVideoFrame);
            };

            updateCameraStatusBadge();
          }).catch(function(err) {
            console.log('Camera stream not active, using HTML Media Capture API fallback:', err);
            updateCameraStatusBadge();
          });
        } else {
          updateCameraStatusBadge();
        }
      }

      function stopCameraStream() {
        if (videoFrameAnimId) {
          cancelAnimationFrame(videoFrameAnimId);
          videoFrameAnimId = null;
        }
        if (mediapipeOverlayCanvas) {
          const ctx = mediapipeOverlayCanvas.getContext('2d');
          ctx.clearRect(0, 0, mediapipeOverlayCanvas.width, mediapipeOverlayCanvas.height);
          mediapipeOverlayCanvas.style.display = 'none';
        }
        if (state.cameraStream) {
          state.cameraStream.getTracks().forEach(track => track.stop());
          state.cameraStream = null;
        }
        if (cameraLiveVideo) {
          cameraLiveVideo.style.display = 'none';
          cameraLiveVideo.srcObject = null;
        }
        realtimePersonDetected = false;
      }

      // 다음 액션 버튼 UI 업데이트
      function updateNextButtonUI() {
        const hasFront = !!state.capturedPhotos.front;
        const hasLeft = !!state.capturedPhotos.left;
        const hasRight = !!state.capturedPhotos.right;

        // 다음 미완료 각도 찾기
        let nextTarget = null;
        if (state.currentAngle === 'front') {
          if (!hasLeft) nextTarget = 'left';
          else if (!hasRight) nextTarget = 'right';
        } else if (state.currentAngle === 'left') {
          if (!hasRight) nextTarget = 'right';
          else if (!hasFront) nextTarget = 'front';
        } else if (state.currentAngle === 'right') {
          if (!hasFront) nextTarget = 'front';
          else if (!hasLeft) nextTarget = 'left';
        }

        if (nextTarget) {
          btnNextAngleText.textContent = `다음: ${getAngleLabel(nextTarget)} 촬영하기 >`;
          btnNextAngleOrAnalyze.dataset.next = nextTarget;
        } else {
          btnNextAngleText.textContent = '3방향 체형 분석 시작하기 ✨';
          btnNextAngleOrAnalyze.dataset.next = 'analyze';
        }
      }

      // 촬영된 이미지 적용 함수
      function applyCapturedPhoto(dataUrl) {
        const curAngle = state.currentAngle;
        state.capturedPhotos[curAngle] = dataUrl;
        state.capturedPhoto = state.capturedPhotos.front || dataUrl;

        cameraPreviewImg.src = dataUrl;
        cameraPreviewImg.style.display = 'block';
        stopCameraStream();

        captureControlsBefore.style.display = 'none';
        captureControlsAfter.style.display = 'flex';
        updateCameraStatusBadge();

        // 썸네일 슬롯 업데이트
        updateThumbSlotUI(curAngle, dataUrl);

        // 탭 뱃지 완료 표시
        updateTabBadgeUI(curAngle);

        updateNextButtonUI();
      }

      // 썸네일 슬롯 UI 업데이트
      function updateThumbSlotUI(angle, dataUrl) {
        let box = null;
        let slot = null;
        if (angle === 'front') { box = thumbBoxFront; slot = thumbSlotFront; }
        else if (angle === 'left') { box = thumbBoxLeft; slot = thumbSlotLeft; }
        else { box = thumbBoxRight; slot = thumbSlotRight; }

        if (box && slot) {
          if (dataUrl) {
            box.innerHTML = `<img src="${dataUrl}" alt="${angle}" style="width:100%; height:100%; object-fit:cover;">`;
            slot.classList.add('completed');
            if (!slot.querySelector('.thumb-check-icon')) {
              const check = document.createElement('div');
              check.className = 'thumb-check-icon';
              check.textContent = '✓';
              slot.appendChild(check);
            }
          } else {
            box.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6e8580" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/></svg>`;
            slot.classList.remove('completed');
            const check = slot.querySelector('.thumb-check-icon');
            if (check) check.remove();
          }
        }
      }

      // 탭 뱃지 UI 업데이트
      function updateTabBadgeUI(angle) {
        let tab = null;
        let badge = null;
        if (angle === 'front') { tab = tabAngleFront; badge = document.getElementById('badgeStepFront'); }
        else if (angle === 'left') { tab = tabAngleLeft; badge = document.getElementById('badgeStepLeft'); }
        else { tab = tabAngleRight; badge = document.getElementById('badgeStepRight'); }

        if (tab && badge) {
          if (state.capturedPhotos[angle]) {
            tab.classList.add('completed');
            badge.textContent = '✓';
          } else {
            tab.classList.remove('completed');
            badge.textContent = angle === 'front' ? '1' : (angle === 'left' ? '2' : '3');
          }
        }
      }

      // 1) 갤러리 업로드 버튼
      if (btnUploadGallery) {
        btnUploadGallery.addEventListener('click', function() {
          filePhotoInput.click();
        });
      }

      // 2) 메인 촬영 버튼 (MediaPipe 신체 인식 검증 연동)
      btnTriggerCapture.addEventListener('click', async function() {
        // 비디오 스트림이 동작 중이면 캔버스에 캡처 후 사람 인식 검증
        if (state.cameraStream && cameraLiveVideo.videoWidth > 0) {
          cameraCanvas.width = cameraLiveVideo.videoWidth;
          cameraCanvas.height = cameraLiveVideo.videoHeight;
          const ctx = cameraCanvas.getContext('2d');
          ctx.drawImage(cameraLiveVideo, 0, 0, cameraCanvas.width, cameraCanvas.height);

          // 사람 신체 인식 검증
          const isDetected = await verifyPersonImage(cameraCanvas);
          if (!isDetected) {
            // 사람이 인식되지 않으면 촬영을 완료하지 않고 안내 메시지 표시!
            showPersonDetectionFailureAlert();
            return;
          }

          const dataUrl = cameraCanvas.toDataURL('image/jpeg', 0.92);
          applyCapturedPhoto(dataUrl);
        } else {
          // HTML Media Capture API 실행
          cameraCaptureInput.click();
        }
      });

      // HTML Media Capture API 결과 수신 (MediaPipe 검증 거침)
      cameraCaptureInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = function(evt) {
            handleCapturedDataUrl(evt.target.result);
          };
          reader.readAsDataURL(file);
        }
        cameraCaptureInput.value = '';
      });

      // 갤러리 선택 결과 수신 (MediaPipe 검증 거침)
      filePhotoInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = function(evt) {
            handleCapturedDataUrl(evt.target.result);
          };
          reader.readAsDataURL(file);
        }
        filePhotoInput.value = '';
      });

      // 3방향 고화질 예시 모델 사진 SVG (사람 형태 검증 통과)
      const sampleModelSvgs = {
        front: 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="400" height="700" viewBox="0 0 400 700"><rect width="400" height="700" fill="%231a2623"/><circle cx="200" cy="120" r="45" fill="%2338c9b2" opacity="0.85"/><path d="M130 190 L270 190 L285 360 L235 380 L245 620 L215 620 L200 420 L185 620 L155 620 L165 380 L115 360 Z" fill="%2338c9b2" opacity="0.65"/><line x1="120" y1="190" x2="280" y2="190" stroke="%23ffffff" stroke-width="3" stroke-dasharray="6 4"/><line x1="200" y1="60" x2="200" y2="650" stroke="%23ffffff" stroke-width="2" stroke-dasharray="8 6" opacity="0.6"/><circle cx="140" cy="190" r="7" fill="%23ffffff"/><circle cx="260" cy="190" r="7" fill="%23ffffff"/><text x="200" y="670" font-family="sans-serif" font-size="18" fill="%2338c9b2" font-weight="bold" text-anchor="middle">FRONT (전신 정면 모델)</text></svg>',
        left: 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="400" height="700" viewBox="0 0 400 700"><rect width="400" height="700" fill="%23162421"/><circle cx="180" cy="120" r="42" fill="%2338c9b2" opacity="0.85"/><path d="M150 190 Q220 220 200 320 Q160 380 230 450 L210 630 L170 630 L165 460 Q140 370 145 280 Z" fill="%2338c9b2" opacity="0.65"/><path d="M180 120 L180 640" stroke="%23ffffff" stroke-width="3" stroke-dasharray="6 4" opacity="0.75"/><circle cx="180" cy="120" r="6" fill="%23ffffff"/><circle cx="180" cy="210" r="6" fill="%23ffffff"/><circle cx="180" cy="420" r="6" fill="%23ffffff"/><circle cx="180" cy="630" r="6" fill="%23ffffff"/><text x="200" y="670" font-family="sans-serif" font-size="18" fill="%2338c9b2" font-weight="bold" text-anchor="middle">LEFT (좌측면 정렬 모델)</text></svg>',
        right: 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="400" height="700" viewBox="0 0 400 700"><rect width="400" height="700" fill="%23162421"/><circle cx="220" cy="120" r="42" fill="%2338c9b2" opacity="0.85"/><path d="M250 190 Q180 220 200 320 Q240 380 170 450 L190 630 L230 630 L235 460 Q260 370 255 280 Z" fill="%2338c9b2" opacity="0.65"/><path d="M220 120 L220 640" stroke="%23ffffff" stroke-width="3" stroke-dasharray="6 4" opacity="0.75"/><circle cx="220" cy="120" r="6" fill="%23ffffff"/><circle cx="220" cy="210" r="6" fill="%23ffffff"/><circle cx="220" cy="420" r="6" fill="%23ffffff"/><circle cx="220" cy="630" r="6" fill="%23ffffff"/><text x="200" y="670" font-family="sans-serif" font-size="18" fill="%2338c9b2" font-weight="bold" text-anchor="middle">RIGHT (우측면 정렬 모델)</text></svg>'
      };

      document.getElementById('btnToggleSamplePhoto').addEventListener('click', function() {
        const cur = state.currentAngle;
        const svg = sampleModelSvgs[cur] || sampleModelSvgs.front;
        handleCapturedDataUrl(svg);
      });

      // 다시 촬영 (현재 각도 재촬영)
      btnRetakePhotoDirect.addEventListener('click', function() {
        const cur = state.currentAngle;
        state.capturedPhotos[cur] = null;
        updateThumbSlotUI(cur, null);
        updateTabBadgeUI(cur);

        cameraPreviewImg.style.display = 'none';
        captureControlsBefore.style.display = 'flex';
        captureControlsAfter.style.display = 'none';
        updateCameraStatusBadge();
        startCameraStream();
      });

      // 다음 각도 이동 또는 설문조사 진행
      btnNextAngleOrAnalyze.addEventListener('click', function() {
        const next = btnNextAngleOrAnalyze.dataset.next;
        if (next === 'front' || next === 'left' || next === 'right') {
          switchCaptureAngle(next);
        } else {
          // 분석(사전 설문조사)으로 이동
          showScreen('screen-survey');
        }
      });

      // ========================================================
      // [Step 4] 사전 설문조사 (1단위 키/몸무게 연동)
      // ========================================================
      document.getElementById('btnBackToCapture').addEventListener('click', function() {
        showScreen('screen-capture', false);
      });

      const surveyHeight = document.getElementById('surveyHeight');
      const surveyWeight = document.getElementById('surveyWeight');

      // 키/몸무게 1단위 변경 리스너
      if (surveyHeight) {
        surveyHeight.addEventListener('change', function(e) {
          state.height = parseInt(e.target.value, 10) || 165;
          updateUserBodySpecUI();
        });
      }
      if (surveyWeight) {
        surveyWeight.addEventListener('change', function(e) {
          state.weight = parseInt(e.target.value, 10) || 55;
          updateUserBodySpecUI();
        });
      }

      function syncReportPhotos() {
        const reportImgF = document.getElementById('reportPhotoImgFront');
        const reportPhF = document.getElementById('reportPhotoPlaceholderFront');
        const reportImgL = document.getElementById('reportPhotoImgLeft');
        const reportPhL = document.getElementById('reportPhotoPlaceholderLeft');
        const reportImgR = document.getElementById('reportPhotoImgRight');
        const reportPhR = document.getElementById('reportPhotoPlaceholderRight');

        if (state.capturedPhotos.front && reportImgF) {
          reportImgF.src = state.capturedPhotos.front;
          reportImgF.style.display = 'block';
          if (reportPhF) reportPhF.style.display = 'none';
        }
        if (state.capturedPhotos.left && reportImgL) {
          reportImgL.src = state.capturedPhotos.left;
          reportImgL.style.display = 'block';
          if (reportPhL) reportPhL.style.display = 'none';
        }
        if (state.capturedPhotos.right && reportImgR) {
          reportImgR.src = state.capturedPhotos.right;
          reportImgR.style.display = 'block';
          if (reportPhR) reportPhR.style.display = 'none';
        }
      }

      function updateUserBodySpecUI() {
        const marketLabel = document.querySelector('#screen-market span[style*="font-weight:700"]');
        if (marketLabel) {
          marketLabel.textContent = `내 체형(${state.height}cm / ${state.weight}kg / ${state.bodyType}) 맞춤만 보기`;
        }

        // 성별에 따라 배너 캐릭터 및 설문조사 문항 이미지 전환
        const activeGender = document.querySelector('[data-gender].active');
        const gender = activeGender ? activeGender.getAttribute('data-gender') : 'female';
        if (typeof updateGenderImages === 'function') {
          updateGenderImages(gender);
        }

        syncReportPhotos();
      }

      // 칩 단일 선택
      function setupSingleChip(attr) {
        document.querySelectorAll(`[${attr}]`).forEach(btn => {
          btn.addEventListener('click', function() {
            document.querySelectorAll(`[${attr}]`).forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
          });
        });
      }
      setupSingleChip('data-gender');
      setupSingleChip('data-shoulder');
      setupSingleChip('data-waist');
      setupSingleChip('data-fat');

      // 설문조사 문항(7~11번) 및 배너 성별 이미지 통합 전환 함수
      function updateGenderImages(gender) {
        var isMale = (gender === 'male');
        
        // 1. 홈 화면 배너 아바타
        var femaleChar = document.getElementById('bannerCharacterFemale');
        var maleChar   = document.getElementById('bannerCharacterMale');
        if (femaleChar && maleChar) {
          femaleChar.style.display = isMale ? 'none' : 'block';
          maleChar.style.display   = isMale ? 'block' : 'none';
        }

        // 2. 7~11번 설문조사 참고 이미지 전체 자동 전환
        document.querySelectorAll('.survey-part-female').forEach(function(el) {
          el.style.display = isMale ? 'none' : 'block';
        });
        document.querySelectorAll('.survey-part-male').forEach(function(el) {
          el.style.display = isMale ? 'block' : 'none';
        });
      }

      // 성별 칩 선택 시 배너 캐릭터 및 설문 문항 이미지 실시간 전환
      document.querySelectorAll('[data-gender]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          setTimeout(function() {
            var gender = btn.getAttribute('data-gender') || 'female';
            updateGenderImages(gender);
          }, 10);
        });
      });

      // 칩 복수 선택 (고민 부위)
      document.querySelectorAll('.chip-multi').forEach(btn => {
        btn.addEventListener('click', function() {
          btn.classList.toggle('active');
        });
      });

      // 체형 정밀 진단 선택지 클릭 이벤트 (data-group별 단일 선택)
      document.querySelectorAll('.survey-option-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          const group = btn.getAttribute('data-group');
          document.querySelectorAll('.survey-option-btn[data-group="' + group + '"]').forEach(function(b) {
            b.classList.remove('active');
          });
          btn.classList.add('active');
        });
      });

      // 설문 제출 -> AI 분석 시작
      document.getElementById('btnSubmitSurvey').addEventListener('click', function() {
        if (surveyHeight) state.height = parseInt(surveyHeight.value, 10) || 165;
        if (surveyWeight) state.weight = parseInt(surveyWeight.value, 10) || 55;

        // 체형 정밀 진단 5문항 집계 (q1~q5)
        var counts = { straight: 0, wave: 0, natural: 0 };
        ['q1','q2','q3','q4','q5'].forEach(function(group) {
          var activeBtn = document.querySelector('.survey-option-btn[data-group="' + group + '"].active');
          if (activeBtn) {
            var t = activeBtn.getAttribute('data-type');
            if (counts[t] !== undefined) counts[t]++;
          }
        });

        var totalVotes = counts.straight + counts.wave + counts.natural;
        if (totalVotes > 0) {
          // 5문항 결과 우선 사용
          if (counts.straight >= counts.wave && counts.straight >= counts.natural) {
            state.bodyType = '스트레이트';
          } else if (counts.wave >= counts.straight && counts.wave >= counts.natural) {
            state.bodyType = '웨이브';
          } else {
            state.bodyType = '내추럴';
          }
        } else {
          // 5문항 미선택 시 기존 어깨 항목으로 폴백
          var activeShoulder = document.querySelector('[data-shoulder].active');
          var shVal = activeShoulder ? activeShoulder.getAttribute('data-shoulder') : 'straight';
          if (shVal === 'straight') state.bodyType = '스트레이트';
          else if (shVal === 'wave') state.bodyType = '웨이브';
          else state.bodyType = '내추럴';
        }

        updateUserBodySpecUI();
        showScreen('screen-loading');
        runLoading();
      });

      // [Step 5] AI 로딩 & 결과 렌더링
      function runLoading() {
        const textEl = document.getElementById('loadingStatusText');
        const msgs = [
          '전신(정면) 랜드마크 33개 포인트 정렬 스캔 중...',
          '좌측면 척추 만곡도 & 거북목 각도 측정 중...',
          '우측면 골반 전방경사 및 대칭 밸런스 교차 검증 중...',
          '3방향 종합 데이터 기반 3대 골격 체형 도출 완료!'
        ];
        let idx = 0;
        textEl.textContent = msgs[0];
        const timer = setInterval(function() {
          idx++;
          if (idx < msgs.length) {
            textEl.textContent = msgs[idx];
          } else {
            clearInterval(timer);
            renderResult();
            showScreen('screen-result');
          }
        }, 750);
      }

      // ========================================================
      // 추천 의류 6종 실제 상품 고화질 컷 & 피팅 상세 데이터
      // ========================================================
