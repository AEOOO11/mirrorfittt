      function updateRealProductPreview(idx) {
        const item = recommendedProductsData[idx];
        if (!item) return;

        // 선택 카드 시각적 하이라이트
        document.querySelectorAll('#homeRecScrollRow .product-card').forEach((c) => {
          const cIdx = parseInt(c.getAttribute('data-rec-idx'), 10);
          if (cIdx === idx) c.classList.add('selected');
          else c.classList.remove('selected');
        });

        const previewCard = document.getElementById('productRealPreviewCard');
        if (!previewCard) return;

        const mallEl = document.getElementById('realPreviewMall');
        const matchEl = document.getElementById('realPreviewMatch');
        const mainImgEl = document.getElementById('realPreviewMainImg');
        const subImgEl = document.getElementById('realPreviewSubImg');
        const brandEl = document.getElementById('realPreviewBrand');
        const titleEl = document.getElementById('realPreviewTitle');
        const commentEl = document.getElementById('realPreviewComment');
        const priceEl = document.getElementById('realPreviewPrice');
        const discountEl = document.getElementById('realPreviewDiscount');
        const btnTextEl = document.getElementById('realPreviewMallBtnText');

        if (mallEl) mallEl.textContent = item.mallBadge;
        if (matchEl) matchEl.textContent = item.matchRate;
        if (mainImgEl) mainImgEl.src = item.mainImg;
        if (subImgEl) subImgEl.src = item.subImg;
        if (brandEl) brandEl.textContent = item.brand;
        if (titleEl) titleEl.textContent = item.title;
        if (commentEl) commentEl.textContent = item.comment;
        if (priceEl) priceEl.textContent = item.price;
        if (discountEl) discountEl.textContent = item.discount;
        if (btnTextEl) btnTextEl.textContent = `${item.mallName} 공식몰에서 보기`;

        const outlinkBtn = document.getElementById('btnRealPreviewOutlink');
        if (outlinkBtn) {
          outlinkBtn.onclick = function() {
            openShoppingMallProduct(item.url, item.mallName, item.title);
          };
        }
      }

      function renderResult() {
        const resTitle = document.getElementById('resultTitle');
        if (resTitle) resTitle.textContent = `당신의 체형은 '${state.bodyType}'`;
        
        const homeTypeEl = document.getElementById('homeBannerType');
        if (homeTypeEl) homeTypeEl.textContent = `${state.bodyType}형`;

        const homeUserEl = document.getElementById('homeAnalysisUserName');
        if (homeUserEl) homeUserEl.textContent = state.userName;

        const shopBodyTypeBadge = document.getElementById('shopBodyTypeBadge');
        if (shopBodyTypeBadge) {
          shopBodyTypeBadge.textContent = `${state.bodyType}형`;
        }

        const svgBox = document.getElementById('resultSvgBox');
        const subBadge = document.getElementById('resultSubBadge');
        const bestList = document.getElementById('resultBestList');
        const worstList = document.getElementById('resultWorstList');

        // 홈 화면 프리미엄 배너 UI 엘리먼트
        const homeBannerBodyBadge = document.getElementById('homeBannerBodyBadge');
        const homeBannerSubMeta = document.getElementById('homeBannerSubMeta');
        const homeBannerFitChips = document.getElementById('homeBannerFitChips');

        if (state.bodyType === '스트레이트') {
          if (subBadge) subBadge.textContent = '상체 중심 입체형';
          if (homeBannerBodyBadge) homeBannerBodyBadge.textContent = '상체 중심 입체형';
          if (homeBannerSubMeta) homeBannerSubMeta.textContent = '신체 밸런스 94점 · 황금비율 지수 1:1.6 (상체 중심축 볼륨형)';

          const straightSvg = `
            <svg width="105" height="145" viewBox="0 0 120 160" fill="none">
              <defs>
                <linearGradient id="resGradStr" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#4ae3cc"/>
                  <stop offset="50%" stop-color="#28bda6"/>
                  <stop offset="100%" stop-color="#199984"/>
                </linearGradient>
                <filter id="resGlowStr" x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="3" result="blur"/>
                  <feComposite in="SourceGraphic" in2="blur" operator="over"/>
                </filter>
              </defs>
              <ellipse cx="60" cy="18" rx="10" ry="12" fill="url(#resGradStr)"/>
              <path d="M56 29 L56 37 L64 37 L64 29 Z" fill="url(#resGradStr)"/>
              <path d="M42 38 C47 36 53 36 60 36 C67 36 73 36 78 38 C83 40 85 45 84 52 C83 60 79 66 75 72 C73 75 71 82 72 90 C73 97 76 102 78 106 L42 106 C44 102 47 97 48 90 C49 82 47 75 45 72 C41 66 37 60 36 52 C35 45 37 40 42 38 Z" fill="url(#resGradStr)"/>
              <path d="M35 44 C33 52 30 65 30 78 C30 88 32 98 33 105 C35 105 37 104 38 101 C36 94 35 84 36 76 C37 68 39 56 41 46 Z" fill="#22aa94"/>
              <path d="M85 44 C87 52 90 65 90 78 C90 88 88 98 87 105 C85 105 83 104 82 101 C84 94 85 84 84 76 C83 68 81 56 79 46 Z" fill="#22aa94"/>
              <path d="M44 106 C45 116 47 128 47 138 C47 146 45 152 44 156 L55 156 C57 151 57 144 57 136 C57 126 56 116 57 106 Z" fill="#1b8e7c"/>
              <path d="M76 106 C75 116 73 128 73 138 C73 146 75 152 76 156 L65 156 C63 151 63 144 63 136 C63 126 64 116 63 106 Z" fill="#1b8e7c"/>
              <line x1="36" y1="41" x2="84" y2="41" stroke="#ffffff" stroke-width="1.3" stroke-dasharray="2 2" opacity="0.9"/>
              <circle cx="51" cy="54" r="2.5" fill="#ffffff" filter="url(#resGlowStr)"/>
              <circle cx="69" cy="54" r="2.5" fill="#ffffff" filter="url(#resGlowStr)"/>
              <line x1="40" y1="104" x2="80" y2="104" stroke="#ffffff" stroke-width="1.3" stroke-dasharray="2 2" opacity="0.9"/>
            </svg>
          `;
          if (svgBox) svgBox.innerHTML = straightSvg;

          if (bestList) bestList.innerHTML = '<li>클래식 스탠다드 셔츠</li><li>일자 스트레이트 슬랙스</li><li>V넥 &amp; 스퀘어넥 상의</li>';
          if (worstList) worstList.innerHTML = '<li>과도한 프릴 &amp; 퍼프소매</li><li>루즈핏 오버사이즈 니트</li><li>얇고 주름지는 쉬폰 소재</li>';

          if (homeBannerFitChips) {
            homeBannerFitChips.innerHTML = `
              <span class="b-chip">클래식 테일러드</span>
              <span class="b-chip">일자 스트레이트 슬랙스</span>
              <span class="b-chip">스퀘어/V넥</span>
            `;
          }
        } else if (state.bodyType === '웨이브') {
          if (subBadge) subBadge.textContent = '하체 중심 곡선형';
          if (homeBannerBodyBadge) homeBannerBodyBadge.textContent = '하체 중심 곡선형';
          if (homeBannerSubMeta) homeBannerSubMeta.textContent = '신체 밸런스 92점 · 황금비율 지수 1:1.5 (하체 중심 라인형)';

          const waveSvg = `
            <svg width="105" height="145" viewBox="0 0 120 160" fill="none">
              <defs>
                <linearGradient id="resGradWav" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#55e8d2"/>
                  <stop offset="50%" stop-color="#22baa2"/>
                  <stop offset="100%" stop-color="#148d79"/>
                </linearGradient>
                <filter id="resGlowWav" x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="3" result="blur"/>
                  <feComposite in="SourceGraphic" in2="blur" operator="over"/>
                </filter>
              </defs>
              <ellipse cx="60" cy="16" rx="9" ry="11" fill="url(#resGradWav)"/>
              <path d="M57 26 L57 37 L63 37 L63 26 Z" fill="url(#resGradWav)"/>
              <path d="M46 38 C49 37 54 37 60 37 C66 37 71 37 74 38 C79 40 80 46 78 54 C76 62 72 70 68 76 C66 80 65 85 66 90 C68 96 75 102 81 108 L39 108 C45 102 52 96 54 90 C55 85 54 80 52 76 C48 70 44 62 42 54 C40 46 41 40 46 38 Z" fill="url(#resGradWav)"/>
              <path d="M39 44 C37 52 35 65 35 78 C35 88 36 98 37 105 C38 105 40 104 41 101 C40 94 39 84 40 76 C41 68 43 56 44 46 Z" fill="#22aa94"/>
              <path d="M81 44 C83 52 85 65 85 78 C85 88 84 98 83 105 C82 105 80 104 79 101 C80 94 81 84 80 76 C79 68 77 56 76 46 Z" fill="#22aa94"/>
              <path d="M41 108 C43 118 45 130 45 140 C45 147 44 153 43 156 L54 156 C55 151 55 144 55 137 C55 127 54 117 55 108 Z" fill="#1b8e7c"/>
              <path d="M79 108 C77 118 75 130 75 140 C75 147 76 153 77 156 L66 156 C65 151 65 144 65 137 C65 127 66 117 65 108 Z" fill="#1b8e7c"/>
              <path d="M49 41 Q60 44 71 41" stroke="#ffffff" stroke-width="1.3" fill="none" opacity="0.9"/>
              <line x1="51" y1="78" x2="69" y2="78" stroke="#ffffff" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.8"/>
              <line x1="36" y1="102" x2="84" y2="102" stroke="#ffffff" stroke-width="1.4" stroke-dasharray="2 2" opacity="0.9"/>
              <circle cx="39" cy="102" r="2.5" fill="#ffffff" filter="url(#resGlowWav)"/>
              <circle cx="81" cy="102" r="2.5" fill="#ffffff" filter="url(#resGlowWav)"/>
            </svg>
          `;
          if (svgBox) svgBox.innerHTML = waveSvg;

          if (bestList) bestList.innerHTML = '<li>하이웨이스트 &amp; A라인 스커트</li><li>크롭 가디건 및 블라우스</li><li>부드러운 쉬폰, 트위드</li>';
          if (worstList) worstList.innerHTML = '<li>로우웨이스트 팬츠</li><li>길게 늘어지는 루즈핏 원피스</li><li>두껍고 뻣뻣한 헤비 데님</li>';

          if (homeBannerFitChips) {
            homeBannerFitChips.innerHTML = `
              <span class="b-chip">하이웨이스트 A라인</span>
              <span class="b-chip">크롭 카디건</span>
              <span class="b-chip">소프트 트위드</span>
            `;
          }
        } else {
          if (subBadge) subBadge.textContent = '골격 프레임 중심형';
          if (homeBannerBodyBadge) homeBannerBodyBadge.textContent = '골격 프레임 중심형';
          if (homeBannerSubMeta) homeBannerSubMeta.textContent = '신체 밸런스 96점 · 황금비율 지수 1:1.7 (내추럴 프레임 균형형)';

          const naturalSvg = `
            <svg width="105" height="145" viewBox="0 0 120 160" fill="none">
              <defs>
                <linearGradient id="resGradNat" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#5ff0d8"/>
                  <stop offset="50%" stop-color="#2fc9b2"/>
                  <stop offset="100%" stop-color="#189d87"/>
                </linearGradient>
                <filter id="resGlowNat" x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="3" result="blur"/>
                  <feComposite in="SourceGraphic" in2="blur" operator="over"/>
                </filter>
              </defs>
              <ellipse cx="60" cy="17" rx="10" ry="12" fill="url(#resGradNat)"/>
              <path d="M55 28 L55 36 L65 36 L65 28 Z" fill="url(#resGradNat)"/>
              <path d="M37 38 C44 36 52 36 60 36 C68 36 76 36 83 38 C89 40 90 46 88 54 C86 63 82 72 79 80 C77 86 76 94 77 106 L43 106 C44 94 43 86 41 80 C38 72 34 63 32 54 C30 46 31 40 37 38 Z" fill="url(#resGradNat)"/>
              <path d="M30 42 C27 52 26 66 26 80 C26 90 28 100 29 108 C31 108 33 107 34 104 C32 96 31 85 32 76 C33 67 36 54 38 45 Z" fill="#22aa94"/>
              <path d="M90 42 C93 52 94 66 94 80 C94 90 92 100 91 108 C89 108 87 107 86 104 C88 96 89 85 88 76 C87 67 84 54 82 45 Z" fill="#22aa94"/>
              <path d="M43 106 C44 117 45 129 45 139 C45 147 43 153 42 156 L54 156 C56 151 57 144 57 136 C57 126 56 116 57 106 Z" fill="#1b8e7c"/>
              <path d="M77 106 C76 117 75 129 75 139 C75 147 77 153 78 156 L66 156 C64 151 63 144 63 136 C63 126 64 116 63 106 Z" fill="#1b8e7c"/>
              <line x1="30" y1="39" x2="90" y2="39" stroke="#ffffff" stroke-width="1.6" stroke-dasharray="2 2" opacity="0.95"/>
              <circle cx="33" cy="39" r="3" fill="#ffffff" filter="url(#resGlowNat)"/>
              <circle cx="87" cy="39" r="3" fill="#ffffff" filter="url(#resGlowNat)"/>
              <line x1="42" y1="42" x2="78" y2="42" stroke="#ffffff" stroke-width="1.2" opacity="0.85"/>
            </svg>
          `;
          if (svgBox) svgBox.innerHTML = naturalSvg;

          if (bestList) bestList.innerHTML = '<li>오버핏 더블 블레이저 자켓</li><li>롱 와이드 팬츠</li><li>린넨, 코듀로이, 생지 데님</li>';
          if (worstList) worstList.innerHTML = '<li>과도하게 밀착되는 스키니핏</li><li>작고 얇은 미니 스커트</li><li>광택이 심한 실크/새틴</li>';

          if (homeBannerFitChips) {
            homeBannerFitChips.innerHTML = `
              <span class="b-chip">오버핏 더블 자켓</span>
              <span class="b-chip">롱 와이드 팬츠</span>
              <span class="b-chip">헤비 코튼/데님</span>
            `;
          }
        }

        updateUserBodySpecUI();

        // 상세 리포트 화면 3방향 사진 뷰 동기화
        const reportImgF = document.getElementById('reportPhotoImgFront');
        const reportPhF = document.getElementById('reportPhotoPlaceholderFront');
        const reportImgL = document.getElementById('reportPhotoImgLeft');
        const reportPhL = document.getElementById('reportPhotoPlaceholderLeft');
        const reportImgR = document.getElementById('reportPhotoImgRight');
        const reportPhR = document.getElementById('reportPhotoPlaceholderRight');

        if (state.capturedPhotos.front && reportImgF) {
          reportImgF.src = state.capturedPhotos.front;
          reportImgF.style.display = 'block';
          if (reportPhF) reportPhF.style.display = 'none';
        }
        if (state.capturedPhotos.left && reportImgL) {
          reportImgL.src = state.capturedPhotos.left;
          reportImgL.style.display = 'block';
          if (reportPhL) reportPhL.style.display = 'none';
        }
        if (state.capturedPhotos.right && reportImgR) {
          reportImgR.src = state.capturedPhotos.right;
          reportImgR.style.display = 'block';
          if (reportPhR) reportPhR.style.display = 'none';
        }
      }

      document.getElementById('btnGoToHome').addEventListener('click', function() {
        showScreen('screen-home');
      });

      // [Step 6] 홈 화면 버튼 연결
      document.getElementById('btnOpenDetailedReport').addEventListener('click', function() {
        showScreen('screen-report-detail');
      });
      document.getElementById('btnServiceAnalysis').addEventListener('click', function() {
        showScreen('screen-report-detail');
      });
      document.getElementById('btnServiceStyling').addEventListener('click', function() {
        showScreen('screen-styling');
      });
      document.getElementById('btnServicePosture').addEventListener('click', function() {
        showScreen('screen-posture');
      });
      document.getElementById('btnServiceMarket').addEventListener('click', function() {
        showScreen('screen-market');
      });
      document.getElementById('btnHeaderProfile').addEventListener('click', function() {
        showScreen('screen-posture');
      });

      // ========================================================
      // 무신사 & 에이블리 실제 상품 페이지 아웃링크 연동 및 카드 인터랙션
      // ========================================================
      function openShoppingMallProduct(url, mall, name) {
        if (!url) return;
        window.open(url, '_blank');
      }

      document.querySelectorAll('.outlink-product').forEach(card => {
        card.addEventListener('click', function(e) {
          // 1. 찜(♡) 버튼 클릭
          const wishBtn = e.target.closest('.btn-card-wish');
          if (wishBtn) {
            e.stopPropagation();
            wishBtn.classList.toggle('active');
            const svgPath = wishBtn.querySelector('path');
            if (wishBtn.classList.contains('active')) {
              wishBtn.style.color = '#ff3358';
              wishBtn.style.background = 'rgba(255, 235, 238, 0.95)';
              if (svgPath) svgPath.setAttribute('fill', '#ff3358');
            } else {
              wishBtn.style.color = '#8c9e9a';
              wishBtn.style.background = 'rgba(255, 255, 255, 0.9)';
              if (svgPath) svgPath.setAttribute('fill', 'none');
            }
            return;
          }

          // 2. 홈 화면 추천 아이템 카드인 경우
          const recIdxAttr = card.getAttribute('data-rec-idx');
          if (recIdxAttr !== null) {
            const idx = parseInt(recIdxAttr, 10);
            updateRealProductPreview(idx);

            // '구매 ↗' 버튼을 직접 클릭한 경우에만 아웃링크 오픈
            if (e.target.closest('.product-outlink-tag')) {
              const url = card.getAttribute('data-url');
              const mall = card.getAttribute('data-mall') || '쇼핑몰';
              const name = card.getAttribute('data-name') || '상품';
              openShoppingMallProduct(url, mall, name);
            }
            return;
          }

          // 3. SHOP 메뉴 등의 기타 outlink-product 클릭
          const url = card.getAttribute('data-url');
          const mall = card.getAttribute('data-mall') || '쇼핑몰';
          const name = card.getAttribute('data-name') || '상품';
          openShoppingMallProduct(url, mall, name);
        });
      });

      // 초기 실행 시 렌더링 호출 (초기 홈 화면 AI 골격 분석 및 첫 번째 추천 아이템 실물 뷰 동기화)
      renderResult();
      updateRealProductPreview(0);

      // ========================================================
      // SHOP 메뉴: 무신사/에이블리 및 체형별 필터링
      // ========================================================
      let activeMallFilter = 'all';
      let activeCatFilter = 'all';

      const mallFilterChips = document.querySelectorAll('[data-mall-filter]');
      const catFilterChips = document.querySelectorAll('[data-cat-filter]');
      const shopCards = document.querySelectorAll('#shopProductsGrid .shop-card');

      function filterShopItems() {
        shopCards.forEach(card => {
          const mall = card.getAttribute('data-mall');
          const cat = card.getAttribute('data-cat');
          const fit = card.getAttribute('data-fit');

          let mallMatch = false;
          if (activeMallFilter === 'all') {
            mallMatch = true;
          } else if (activeMallFilter === 'musinsa') {
            mallMatch = (mall === '무신사');
          } else if (activeMallFilter === 'ably') {
            mallMatch = (mall === '에이블리');
          } else if (activeMallFilter === 'myfit') {
            mallMatch = (fit === state.bodyType);
          }

          let catMatch = (activeCatFilter === 'all' || cat === activeCatFilter);

          if (mallMatch && catMatch) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      }

      mallFilterChips.forEach(chip => {
        chip.addEventListener('click', function() {
          mallFilterChips.forEach(c => c.classList.remove('active'));
          chip.classList.add('active');
          activeMallFilter = chip.getAttribute('data-mall-filter');
          filterShopItems();
        });
      });

      catFilterChips.forEach(chip => {
        chip.addEventListener('click', function() {
          catFilterChips.forEach(c => {
            c.classList.remove('active');
            c.style.background = 'var(--white)';
            c.style.color = 'var(--text-sub)';
            c.style.fontWeight = '600';
          });
          chip.classList.add('active');
          chip.style.background = 'var(--primary-mint-soft)';
          chip.style.color = 'var(--primary-mint-dark)';
          chip.style.fontWeight = '700';
          activeCatFilter = chip.getAttribute('data-cat-filter');
          filterShopItems();
        });
      });

      // [Step 7-1] 상세 리포트
      document.getElementById('btnBackFromReport').addEventListener('click', goBack);
      document.getElementById('btnRetakePhoto').addEventListener('click', function() {
        showScreen('screen-capture');
      });

      // [Step 7-2] 자세 교정 & 타이머
      document.getElementById('btnBackFromPosture').addEventListener('click', goBack);
      const timerModal = document.getElementById('timerModal');
      const timerDisplay = document.getElementById('timerDisplay');
      let countdown = null;

      document.querySelectorAll('.btn-timer-trigger').forEach(btn => {
        btn.addEventListener('click', function() {
          let s = parseInt(btn.getAttribute('data-sec'), 10) || 30;
          timerDisplay.textContent = `${s}s`;
          timerModal.classList.add('active');

          clearInterval(countdown);
          countdown = setInterval(function() {
            s--;
            if (s <= 0) {
              clearInterval(countdown);
              timerDisplay.textContent = '완료! 👏';
            } else {
              timerDisplay.textContent = `${s}s`;
            }
          }, 1000);
        });
      });

      document.getElementById('btnFinishTimer').addEventListener('click', function() {
        clearInterval(countdown);
        timerModal.classList.remove('active');
      });

      // [Step 7-3] SHOP 뒤로가기
      document.getElementById('btnBackFromStyling').addEventListener('click', goBack);

      // [Step 7-4] 연계 중고거래
      document.getElementById('btnBackFromMarket').addEventListener('click', goBack);
      const marketModal = document.getElementById('marketModal');
      const mTitle = document.getElementById('modalMTitle');
      const mPrice = document.getElementById('modalMPrice');
      const modalMImg = document.getElementById('modalMImg');
      const modalMImgWrap = document.getElementById('modalMImgWrap');
      const modalMUrlBadge = document.getElementById('modalMUrlBadge');
      let currentModalUrl = '';

      if (modalMImgWrap) {
        modalMImgWrap.addEventListener('click', function() {
          if (currentModalUrl) {
            window.open(currentModalUrl, '_blank', 'noopener,noreferrer');
          }
        });
      }

      document.querySelectorAll('.market-card-row').forEach(row => {
        row.addEventListener('click', function(e) {
          // 썸네일 링크 또는 버튼 직접 클릭 시 모달 중복 오픈 방지
          if (e.target.closest('a')) return;

          mTitle.textContent = row.getAttribute('data-m-title');
          mPrice.textContent = row.getAttribute('data-m-price');
          const imgSrc = row.getAttribute('data-m-img');
          currentModalUrl = row.getAttribute('data-m-url') || '';

          if (modalMImg && imgSrc) {
            modalMImg.src = imgSrc;
          }
          if (modalMUrlBadge) {
            modalMUrlBadge.style.display = currentModalUrl ? 'block' : 'none';
          }
          marketModal.classList.add('active');
        });
      });

      document.getElementById('btnCloseMarketModal').addEventListener('click', function() {
        marketModal.classList.remove('active');
      });

      document.getElementById('btnChatModal').addEventListener('click', function() {
        alert(`[1:1 피팅 문의 채팅방 연결]\n판매자님에게 메시지를 보냈습니다:\n"동일한 ${state.bodyType}형인데 허리랑 어깨 착용감 문의드려요!"`);
        marketModal.classList.remove('active');
      });

      document.getElementById('btnBuyModal').addEventListener('click', function() {
        alert(`[미러핏 안전 결제]\n${mTitle.textContent}\n안전 거래 에스크로 결제가 정상적으로 완료되었습니다.`);
        marketModal.classList.remove('active');
      });

      document.getElementById('btnOpenSellModal').addEventListener('click', function() {
        const t = prompt('판매할 옷의 상품명을 입력하세요:', '스트레이트 핏 자켓');
        if (t) {
          const p = prompt('판매 희망 가격을 입력하세요 (숫자):', '35000');
          if (p) {
            alert(`[판매 등록 완료]\n"${t}" (${Number(p).toLocaleString()}원) 상품이 등록되었습니다.\n회원님의 체형 데이터(${state.height}cm / ${state.weight}kg / ${state.bodyType}형)가 정품 체형 인증 뱃지로 부착되었습니다!`);
          }
        }
      });

      // [Step 7-4] 네이버 지도 클릭 이벤트 (안산대학교)
      const naverMapLink = document.getElementById('naverMapLink');
      if (naverMapLink) {
        naverMapLink.addEventListener('click', function(e) {
          e.preventDefault();
          window.open(
            'https://map.naver.com/p/search/%EC%95%88%EC%82%B0%EB%8C%80%ED%95%99%EA%B5%90/place/31599329',
            '_blank',
            'noopener,noreferrer'
          );
        });
      }

    })();
  </script>
</body>
</html>
