                  <option value="120">120 kg</option>
                </select>
                <span class="select-arrow">▼</span>
              </div>
            </div>
          </div>

          <!-- 2. 성별 -->
          <div class="survey-group">
            <div class="survey-label" style="display:flex; align-items:center; gap:6px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary-mint-dark)" stroke-width="2.2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
              <span>2. 성별</span>
            </div>
            <div class="chip-2col">
              <button class="chip-btn active" data-gender="female">여성</button>
              <button class="chip-btn" data-gender="male">남성</button>
            </div>
          </div>

          <!-- 3. 어깨 쇄골 -->
          <div class="survey-group">
            <div class="survey-label" style="display:flex; align-items:center; gap:6px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary-mint-dark)" stroke-width="2.2" stroke-linecap="round"><path d="M4 10h16M7 6l5 4 5-4"/></svg>
              <span>3. 어깨 및 쇄골 골격</span>
            </div>
            <div class="chip-3col">
              <button class="chip-btn active" data-shoulder="straight">도톰 &amp; 탄력</button>
              <button class="chip-btn" data-shoulder="wave">가녀림 &amp; 쇄골</button>
              <button class="chip-btn" data-shoulder="natural">넓고 각진 뼈대</button>
            </div>
          </div>

          <!-- 4. 허리 골반 -->
          <div class="survey-group">
            <div class="survey-label" style="display:flex; align-items:center; gap:6px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary-mint-dark)" stroke-width="2.2" stroke-linecap="round"><path d="M5 8c3 2 4 6 2 10M19 8c-3 2-4 6-2 10"/></svg>
              <span>4. 허리 둘레 및 골반 위치</span>
            </div>
            <div class="chip-2col">
              <button class="chip-btn active" data-waist="high">골반 높고 허리 뚜렷</button>
              <button class="chip-btn" data-waist="long">허리선 길고 완만함</button>
            </div>
          </div>

          <!-- 5. 평소 고민 부위 (복수 선택 - 첨부 3) -->
          <div class="survey-group">
            <div class="survey-label" style="display:flex; align-items:center; gap:6px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary-mint-dark)" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/><line x1="12" y1="2" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22"/><line x1="2" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22" y2="12"/></svg>
              <span>5. 평소 고민 부위 <small>(복수 선택 가능)</small></span>
            </div>
            <div class="chip-2col">
              <button class="chip-btn chip-multi" data-worry="shoulder">어깨</button>
              <button class="chip-btn chip-multi active" data-worry="waist">허리</button>
              <button class="chip-btn chip-multi" data-worry="hip">엉덩이</button>
              <button class="chip-btn chip-multi active" data-worry="thigh">허벅지</button>
            </div>
          </div>

          <!-- 6. 체중 증가 패턴 -->
          <div class="survey-group">
            <div class="survey-label" style="display:flex; align-items:center; gap:6px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary-mint-dark)" stroke-width="2.2" stroke-linecap="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              <span>6. 체중 증가 시 살이 붙는 패턴</span>
            </div>
            <div class="chip-3col">
              <button class="chip-btn active" data-fat="upper">상체/팔뚝</button>
              <button class="chip-btn" data-fat="lower">하체/엉덩이</button>
              <button class="chip-btn" data-fat="all">전신 골고루</button>
            </div>
          </div>

          <!-- 체형 정밀 진단 5문항 -->
          <div style="margin:18px 0 6px; padding:12px 14px; background:var(--mint-bg,rgba(74,227,204,0.08)); border-radius:12px; border-left:3px solid var(--primary-mint-dark,#148d79);">
            <div style="font-size:12px; font-weight:700; color:var(--primary-mint-dark,#148d79); letter-spacing:0.03em; margin-bottom:4px;">체형 정밀 진단</div>
            <div style="font-size:11px; color:#888;">아래 5가지 질문에 솔직하게 답해주세요. 정확한 체형 분석에 활용됩니다.</div>
          </div>

          <!-- Q1: 신체 두께감 -->
          <div class="survey-group">
            <div class="survey-label" style="display:flex; align-items:center; gap:6px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary-mint-dark)" stroke-width="2.2" stroke-linecap="round"><path d="M12 2C8 2 4 6 4 10c0 5 8 12 8 12s8-7 8-12c0-4-4-8-8-8z"/></svg>
              <span>7. 신체 두께감 및 옆모습</span>
            </div>
            <div style="font-size:12px; color:#666; margin:4px 0 10px; line-height:1.5;">옆모습이나 상체를 보았을 때 나의 체형 두께감은 어떤가요?</div>
            <!-- 실제 체형 참고 사진 (스트레이트 / 웨이브 / 내추럴) -->
            <div class="survey-part-img-box" style="margin:8px 0 12px; border-radius:12px; overflow:hidden; border:1px solid var(--border-light); box-shadow:0 2px 8px rgba(0,0,0,0.04); background:#fff;">
              <img class="survey-part-female" src="data:image/jpeg;base64," alt="여성 신체 두께감 참고 사진" style="width:100%; height:auto; display:block;">
              <img class="survey-part-male" src="data:image/jpeg;base64," alt="남성 신체 두께감 참고 사진" style="width:100%; height:auto; display:none;">
            </div>
            <div class="survey-option-list">
              <button class="survey-option-btn" data-group="q1" data-type="straight">
                <span class="survey-option-badge">A</span>
                <span class="survey-option-text">옆모습이 두툼하고 상체(특히 흉곽)에 입체적인 볼륨감이 있다.</span>
              </button>
              <button class="survey-option-btn" data-group="q1" data-type="wave">
                <span class="survey-option-badge">B</span>
                <span class="survey-option-text">전체적으로 두께가 얇고 평면적이며, 옆모습이 슬림하다.</span>
              </button>
              <button class="survey-option-btn" data-group="q1" data-type="natural">
                <span class="survey-option-badge">C</span>
                <span class="survey-option-text">뼈대 자체가 굵직하고 탄탄하여 프레임감이 느껴지며, 옆모습에 단단한 골격이 드러난다.</span>
              </button>
            </div>
          </div>

          <!-- Q2: 살의 질감 및 탄력 -->
          <div class="survey-group">
            <div class="survey-label" style="display:flex; align-items:center; gap:6px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary-mint-dark)" stroke-width="2.2" stroke-linecap="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              <span>8. 살의 질감 및 탄력</span>
            </div>
            <div style="font-size:12px; color:#666; margin:4px 0 10px; line-height:1.5;">살을 살짝 꼬집거나 눌렀을 때 느껴지는 질감은 어떠한가요?</div>
            <!-- 실제 체형 참고 사진 (스트레이트 / 웨이브 / 내추럴) -->
            <div class="survey-part-img-box" style="margin:8px 0 12px; border-radius:12px; overflow:hidden; border:1px solid var(--border-light); box-shadow:0 2px 8px rgba(0,0,0,0.04); background:#fff;">
              <img class="survey-part-female" src="data:image/jpeg;base64," alt="여성 피부 질감 참고 사진" style="width:100%; height:auto; display:block;">
              <img class="survey-part-male" src="data:image/jpeg;base64," alt="남성 피부 질감 참고 사진" style="width:100%; height:auto; display:none;">
            </div>
            <div class="survey-option-list">
              <button class="survey-option-btn" data-group="q2" data-type="straight">
                <span class="survey-option-badge">A</span>
                <span class="survey-option-text">탄력이 있고 근육이나 탄탄한 조직감이 느껴져 살이 단단하다.</span>
              </button>
              <button class="survey-option-btn" data-group="q2" data-type="wave">
                <span class="survey-option-badge">B</span>
                <span class="survey-option-text">폭신하고 부드러우며, 말랑말랑한 질감이다.</span>
              </button>
              <button class="survey-option-btn" data-group="q2" data-type="natural">
                <span class="survey-option-badge">C</span>
                <span class="survey-option-text">피부가 건조하거나 퍼석한 편이며, 뼈와 관절이 도드라져 뼈 라인이 바로 만져진다.</span>
              </button>
            </div>
          </div>

          <!-- Q3: 쇄골과 어깨 프레임 -->
          <div class="survey-group">
            <div class="survey-label" style="display:flex; align-items:center; gap:6px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary-mint-dark)" stroke-width="2.2" stroke-linecap="round"><path d="M4 10h16M7 6l5 4 5-4"/></svg>
              <span>9. 쇄골과 어깨 프레임</span>
            </div>
            <div style="font-size:12px; color:#666; margin:4px 0 10px; line-height:1.5;">쇄골과 어깨 라인의 형태는 어떤가요?</div>
            <!-- 실제 체형 참고 사진 (스트레이트 / 웨이브 / 내추럴) -->
            <div class="survey-part-img-box" style="margin:8px 0 12px; border-radius:12px; overflow:hidden; border:1px solid var(--border-light); box-shadow:0 2px 8px rgba(0,0,0,0.04); background:#fff;">
              <img class="survey-part-female" src="data:image/jpeg;base64," alt="여성 쇄골 및 어깨 참고 사진" style="width:100%; height:auto; display:block;">
              <img class="survey-part-male" src="data:image/jpeg;base64," alt="남성 쇄골 및 어깨 참고 사진" style="width:100%; height:auto; display:none;">
            </div>
            <div class="survey-option-list">
              <button class="survey-option-btn" data-group="q3" data-type="straight">
                <span class="survey-option-badge">A</span>
                <span class="survey-option-text">쇄골이 짧고 깊게 파여 눈에 잘 띄지 않으며, 어깨선이 둥글고 매끄럽다.</span>
              </button>
              <button class="survey-option-btn" data-group="q3" data-type="wave">
                <span class="survey-option-badge">B</span>
                <span class="survey-option-text">쇄골이 가늘고 가냘프게 일직선으로 살짝 드러나며, 어깨가 좁고 부드럽게 내려가 있다.</span>
              </button>
              <button class="survey-option-btn" data-group="q3" data-type="natural">
                <span class="survey-option-badge">C</span>
                <span class="survey-option-text">쇄골이 크고 굵직하게 도드라지며, 어깨 프레임이 넓고 확고하다.</span>
              </button>
            </div>
          </div>

          <!-- Q4: 손과 손목의 특징 -->
          <div class="survey-group">
            <div class="survey-label" style="display:flex; align-items:center; gap:6px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary-mint-dark)" stroke-width="2.2" stroke-linecap="round"><path d="M18 11V6a2 2 0 0 0-2-2 2 2 0 0 0-2 2v5M14 10V4a2 2 0 0 0-2-2 2 2 0 0 0-2 2v6M10 10.5V6a2 2 0 0 0-2-2 2 2 0 0 0-2 2v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/></svg>
              <span>10. 손과 손목의 특징</span>
            </div>
            <div style="font-size:12px; color:#666; margin:4px 0 10px; line-height:1.5;">손목과 손가락의 뼈마디를 관찰했을 때 어떤 특징이 있나요?</div>
            <!-- 실제 체형 참고 사진 (스트레이트 / 웨이브 / 내추럴) -->
            <div class="survey-part-img-box" style="margin:8px 0 12px; border-radius:12px; overflow:hidden; border:1px solid var(--border-light); box-shadow:0 2px 8px rgba(0,0,0,0.04); background:#fff;">
              <img class="survey-part-female" src="data:image/jpeg;base64," alt="여성 손 및 손목 참고 사진" style="width:100%; height:auto; display:block;">
              <img class="survey-part-male" src="data:image/jpeg;base64," alt="남성 손 및 손목 참고 사진" style="width:100%; height:auto; display:none;">
            </div>
            <div class="survey-option-list">
              <button class="survey-option-btn" data-group="q4" data-type="straight">
                <span class="survey-option-badge">A</span>
                <span class="survey-option-text">손목이 둥글고 단단하며, 손등에 살집이 있어 뼈가 크게 두드러지지 않는다.</span>
              </button>
              <button class="survey-option-btn" data-group="q4" data-type="wave">
                <span class="survey-option-badge">B</span>
                <span class="survey-option-text">손목이 가늘고 동글동글하며, 손가락 마디가 얇고 매끄럽다.</span>
              </button>
              <button class="survey-option-btn" data-group="q4" data-type="natural">
                <span class="survey-option-badge">C</span>
                <span class="survey-option-text">손목 뼈와 손가락 관절 마디가 굵고 뼈마디가 도드라져 보인다.</span>
              </button>
            </div>
          </div>

          <!-- Q5: 무릎 및 하체 중심 -->
          <div class="survey-group">
            <div class="survey-label" style="display:flex; align-items:center; gap:6px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary-mint-dark)" stroke-width="2.2" stroke-linecap="round"><path d="M12 2v20M5 7l7 5 7-5"/></svg>
              <span>11. 무릎 및 하체 중심</span>
            </div>
            <div style="font-size:12px; color:#666; margin:4px 0 10px; line-height:1.5;">무릎 슬개골(무릎뼈) 모양과 체중이 실리는 하체 특징은 어떤가요?</div>
            <!-- 실제 체형 참고 사진 (스트레이트 / 웨이브 / 내추럴) -->
            <div class="survey-part-img-box" style="margin:8px 0 12px; border-radius:12px; overflow:hidden; border:1px solid var(--border-light); box-shadow:0 2px 8px rgba(0,0,0,0.04); background:#fff;">
              <img class="survey-part-female" src="data:image/jpeg;base64," alt="여성 무릎 및 하체 참고 사진" style="width:100%; height:auto; display:block;">
              <img class="survey-part-male" src="data:image/jpeg;base64," alt="남성 무릎 및 하체 참고 사진" style="width:100%; height:auto; display:none;">
            </div>
            <div class="survey-option-list">
              <button class="survey-option-btn" data-group="q5" data-type="straight">
                <span class="survey-option-badge">A</span>
                <span class="survey-option-text">무릎뼈가 작고 살에 파묻혀 잘 보이지 않으며, 허벅지 위쪽에 탄력이 집중된다.</span>
              </button>
              <button class="survey-option-btn" data-group="q5" data-type="wave">
                <span class="survey-option-badge">B</span>
                <span class="survey-option-text">무릎뼈가 작고 튀어나와 있으며, 엉덩이와 허벅지 아래쪽(하중심)에 볼륨이 쏠린다.</span>
              </button>
              <button class="survey-option-btn" data-group="q5" data-type="natural">
                <span class="survey-option-badge">C</span>
                <span class="survey-option-text">무릎뼈가 크고 단단하며, 다리 프레임이 길고 곧게 뻗어 있다.</span>
              </button>
            </div>
          </div>

          <button class="btn-primary" id="btnSubmitSurvey" style="margin-top:10px;">AI 체형 분석 시작하기</button>
        </div>
      </section>

      <!-- ========================================================
           [Step 5-1] AI 분석 로딩 화면
           ======================================================== -->
      <section class="screen" id="screen-loading">
        <div class="radar-box">
          <div class="radar-circle rc-1"></div>
          <div class="radar-circle rc-2"></div>
          <div class="radar-circle rc-3"></div>
          <div class="scan-beam"></div>
          <svg width="70" height="96" viewBox="0 0 70 100" fill="none">
            <defs>
              <linearGradient id="scanGradBody" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#4ae3cc"/>
                <stop offset="100%" stop-color="#148d79"/>
              </linearGradient>
            </defs>
            <!-- 3D 스캔 인체 모형 -->
            <ellipse cx="35" cy="11" rx="6.5" ry="8" fill="url(#scanGradBody)"/>
            <path d="M23 24 C28 22 32 22 35 22 C38 22 42 22 47 24 C50 26 51 31 49 37 C47 43 45 49 43 54 C42 58 43 64 44 70 L26 70 C27 64 28 58 27 54 C25 49 23 43 21 37 C19 31 20 26 23 24 Z" fill="url(#scanGradBody)" opacity="0.95"/>
            <!-- 팔 -->
            <path d="M19 28 C17 35 16 44 16 52 C16 57 18 63 19 66 C20 66 21 65 22 63 C21 57 21 50 22 44 C23 38 24 32 25 27 Z" fill="#24b69f"/>
            <path d="M51 28 C53 35 54 44 54 52 C54 57 52 63 51 66 C50 66 49 65 48 63 C49 57 49 50 48 44 C47 38 46 32 45 27 Z" fill="#24b69f"/>
            <!-- 다리 -->
            <path d="M27 70 C28 78 29 86 29 94 C29 97 28 99 27 100 L34 100 C35 97 35 93 35 88 C35 82 34 76 35 70 Z" fill="#189380"/>
            <path d="M43 70 C42 78 41 86 41 94 C41 97 42 99 43 100 L36 100 C35 97 35 93 35 88 C35 82 36 76 35 70 Z" fill="#189380"/>
            <!-- 스캔 랜드마크 포인트 오버레이 -->
            <circle cx="24" cy="25" r="1.8" fill="#ffffff"/>
            <circle cx="46" cy="25" r="1.8" fill="#ffffff"/>
            <circle cx="35" cy="40" r="1.5" fill="#ffffff"/>
            <circle cx="28" cy="68" r="1.8" fill="#ffffff"/>
            <circle cx="42" cy="68" r="1.8" fill="#ffffff"/>
            <line x1="20" y1="25" x2="50" y2="25" stroke="#ffffff" stroke-width="0.8" stroke-dasharray="1.5 1.5" opacity="0.8"/>
            <line x1="24" y1="68" x2="46" y2="68" stroke="#ffffff" stroke-width="0.8" stroke-dasharray="1.5 1.5" opacity="0.8"/>
          </svg>
        </div>
        <h3 style="font-size:19px; font-weight:800; margin-bottom:8px;">AI가 체형을 분석하고 있습니다</h3>
        <p style="font-size:13.5px; color:var(--primary-mint-dark); font-weight:700;" id="loadingStatusText">신체 랜드마크 33개 포인트 측정 중...</p>
      </section>

      <!-- ========================================================
           [Step 5-2] AI 분석 결과 화면
           ======================================================== -->
      <section class="screen" id="screen-result">
        <div class="result-top-banner">
          <span style="font-size:12px; font-weight:800; background:rgba(255,255,255,0.25); padding:3px 10px; border-radius:12px;">AI 분석 완료</span>
          <h2 style="font-size:22px; font-weight:800; margin-top:6px;" id="resultTitle">당신의 체형은 '스트레이트'</h2>
          <p style="font-size:13px; opacity:0.9;">입체적인 볼륨감과 탄력 있는 균형 잡힌 실루엣</p>
        </div>

        <div class="result-wrap">
          <div class="result-card">
            <div class="brand-logo-badge" id="resultSubBadge">상체 중심 입체형</div>
            <div id="resultSvgBox" style="height:150px; display:flex; align-items:center; justify-content:center; margin:10px 0;">
              <!-- 동적 SVG -->
            </div>
            <div class="result-scores">
              <div>
                <div class="score-num">94점</div>
                <div class="score-txt">신체 밸런스</div>
              </div>
              <div>
                <div class="score-num">1:1.6</div>
                <div class="score-txt">황금 비율 지수</div>
              </div>
              <div>
                <div class="score-num">상체 우세</div>
                <div class="score-txt">볼륨 중심축</div>
              </div>
            </div>
          </div>

          <div class="fit-grid">
            <div class="fit-box fit-best" style="border:1.5px solid rgba(56,201,178,0.3); background:rgba(56,201,178,0.06);">
              <div style="font-weight:800; color:var(--primary-mint-dark); margin-bottom:8px; display:flex; align-items:center; gap:6px; font-size:13.5px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#179b88" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <span>Best Fit 추천</span>
              </div>
              <ul id="resultBestList">
                <li>클래식 스탠다드 셔츠</li>
                <li>일자 스트레이트 슬랙스</li>
                <li>적당한 V넥 &amp; 스퀘어넥</li>
              </ul>
            </div>
            <div class="fit-box fit-worst" style="border:1.5px solid rgba(231,86,66,0.25); background:rgba(231,86,66,0.04);">
              <div style="font-weight:800; color:#e75642; margin-bottom:8px; display:flex; align-items:center; gap:6px; font-size:13.5px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#e75642" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                <span>Worst Fit 주의</span>
              </div>
              <ul id="resultWorstList">
                <li>과도한 프릴 &amp; 퍼프소매</li>
                <li>루즈핏 오버사이즈 롱니트</li>
                <li>얇고 주름지는 쉬폰 소재</li>
              </ul>
            </div>
          </div>

          <button class="btn-primary" id="btnGoToHome">미러핏 홈으로 이동하기</button>
        </div>
      </section>

      <!-- ========================================================
           [Step 6] 메인 홈 화면 - 세련된 프리미엄 모바일 UI 시스템 (참고 시안 반영)
           ======================================================== -->
      <section class="screen" id="screen-home">
        <!-- 상단 헤더 (참고 시안 스타일) -->
        <div class="home-header">
          <div>
            <div class="home-sub-title">2026 AI 퍼스널 핏 큐레이션</div>
            <h2 class="home-greeting"><span id="homeUserName">산혜</span> 님, 오늘 꼭 맞는 핏을 만나보세요 ✨</h2>
          </div>
          <div class="avatar-icon-btn" id="btnHeaderProfile" title="내 프로필" style="background:linear-gradient(135deg,rgba(56,201,178,0.15),rgba(40,189,166,0.25)); border:1.5px solid var(--primary-mint); width:40px; height:40px; border-radius:50%; display:flex; align-items:center; justify-content:center; cursor:pointer;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary-mint-dark)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </div>
        </div>

        <!-- ⭐ 체형 분석 결과 프리미엄 와이드 비주얼 배너 (정상 노출 & 가독성 강화) ⭐ -->
        <div class="home-banner" style="display:flex !important; flex-direction:column !important; gap:12px !important; padding:18px !important; position:relative !important; overflow:hidden !important;">
          <!-- 상단 프로필 & 분석 정보 행 (참고 이미지: 좌측 원형 아바타 + 우측 텍스트) -->
          <div style="display:flex; align-items:center; gap:14px; position:relative; z-index:2; min-width:0;">
            <!-- 원형 아바타 프레임 (투명 배경 캐릭터 & 최적 비율 적용) -->
            <div style="width:74px; height:74px; min-width:74px; border-radius:50%; background:rgba(255,255,255,0.22); border:2.5px solid rgba(255,255,255,0.65); display:flex; align-items:center; justify-content:center; overflow:hidden; box-shadow:0 4px 14px rgba(0,0,0,0.08); flex-shrink:0; padding:4px;">
              <img id="bannerCharacterFemale" src="data:image/png;base64," alt="여성 캐릭터"
                style="height:90%; width:auto; max-width:90%; object-fit:contain; display:block; image-rendering:pixelated; margin:auto;">
              <img id="bannerCharacterMale" src="data:image/png;base64," alt="남성 캐릭터"
                style="height:90%; width:auto; max-width:90%; object-fit:contain; display:none; image-rendering:pixelated; margin:auto;">
            </div>

            <!-- 우측 텍스트 정보 영역 -->
            <div style="flex:1; min-width:0; display:flex; flex-direction:column; gap:4px;">
              <div class="banner-top-row" style="margin:0;">
                <div class="banner-badge-pill">
                  <span class="live-pulse-dot" style="background:#ffffff; box-shadow:0 0 6px #ffffff;"></span>
                  <span>AI 골격 분석 완료</span>
                </div>
                <span class="banner-scan-tag">33 랜드마크 정밀 스캔</span>
              </div>

              <div class="banner-title-text" style="margin:0; font-size:15px; line-height:1.35;">
                <span id="homeAnalysisUserName">미러핏</span>님의 체형 분석 결과: '<strong id="homeBannerType">스트레이트형</strong>'
                <span class="banner-body-badge" id="homeBannerBodyBadge">상체 중심 입체형</span>
              </div>

              <div class="banner-sub-meta" id="homeBannerSubMeta" style="margin:0; font-size:11.5px; opacity:0.95;">
                신체 밸런스 94점 · 황금비율 지수 1:1.6 (상체 중심축 볼륨형)
              </div>
            </div>
          </div>

          <!-- 하단: 추천 Best Fit 핏 키워드 -->
          <div class="banner-fit-chips" id="homeBannerFitChips" style="position:relative; z-index:2; margin:0;">
            <span class="b-chip">클래식 테일러드</span>
            <span class="b-chip">일자 스트레이트 슬랙스</span>
            <span class="b-chip">스퀘어/V넥</span>
          </div>

          <!-- 하단: 상세 분석 리포트 보기 버튼 -->
          <div class="banner-action-row" style="position:relative; z-index:2; margin-top:2px;">
            <button class="banner-btn" id="btnOpenDetailedReport">
              <span>상세 분석 리포트 보기</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <span class="banner-btn-hint" onclick="document.getElementById('btnOpenDetailedReport').click();">체형 리포트 &gt;</span>
          </div>
        </div>

        <!-- ⭐ 자주 찾는 메뉴 (Quick Menu - 정돈된 1열 4컬럼 퀵 메뉴) ⭐ -->
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
          <h3 class="home-sec-title" style="margin-bottom:0;">자주 찾는 메뉴</h3>
          <span style="font-size:11.5px; color:var(--primary-mint-dark); font-weight:700;">맞춤 케어</span>
        </div>

        <div class="quick-menu-row">
          <!-- 1. AI 체형 진단 -->
          <div class="quick-menu-item" id="btnServiceAnalysis">
            <div class="quick-menu-circle" style="background:linear-gradient(135deg,#e6fbf7,#d1f6ee); border-color:rgba(56,201,178,0.4);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#179b88" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 7V5a2 2 0 0 1 2-2h2"/>
                <path d="M17 3h2a2 2 0 0 1 2 2v2"/>
                <path d="M21 17v2a2 2 0 0 1-2 2h-2"/>
                <path d="M7 21H5a2 2 0 0 1-2-2v-2"/>
                <circle cx="12" cy="9" r="2.5"/>
                <path d="M9 19c0-2 1.5-3.5 3-3.5s3 1.5 3 3.5"/>
              </svg>
            </div>
            <span class="quick-menu-label">체형 진단</span>
          </div>

          <!-- 2. 맞춤 샵 -->
          <div class="quick-menu-item" id="btnServiceStyling">
            <div class="quick-menu-circle" style="background:linear-gradient(135deg,#eef5ff,#dbe9ff); border-color:rgba(43,127,255,0.3);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#256fe6" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a3 3 0 0 0-3 3c0 .8.3 1.5.8 2L2 15a1.5 1.5 0 0 0 1 2h18a1.5 1.5 0 0 0 1-2L14.2 7c.5-.5.8-1.2.8-2a3 3 0 0 0-3-3z"/>
                <path d="M12 17v4"/>
                <path d="M19 6l1-1"/>
                <path d="M18 3h2"/>
              </svg>
            </div>
            <span class="quick-menu-label">맞춤 샵</span>
          </div>

          <!-- 3. 자세 교정 -->
          <div class="quick-menu-item" id="btnServicePosture">
            <div class="quick-menu-circle" style="background:linear-gradient(135deg,#eaf9f1,#cff2df); border-color:rgba(27,158,89,0.3);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#168b4e" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="4.5" r="2.5"/>
                <path d="M12 7.5v6"/>
                <path d="M5 11c2.5-1.5 5-1.8 7-1.8s4.5.3 7 1.8"/>
                <path d="M8 21.5l4-8 4 8"/>
              </svg>
            </div>
            <span class="quick-menu-label">자세 교정</span>
          </div>

          <!-- 4. 체형 마켓 -->
          <div class="quick-menu-item" id="btnServiceMarket">
            <div class="quick-menu-circle" style="background:linear-gradient(135deg,#fff1ed,#ffdcd4); border-color:rgba(255,96,61,0.3);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#e04c2b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                <circle cx="7" cy="7" r="1.5" fill="currentColor"/>
                <path d="M16 8l3 3"/>
              </svg>
            </div>
            <span class="quick-menu-label">체형 마켓</span>
          </div>
        </div>

