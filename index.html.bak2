<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <!-- 모바일 뷰포트 최적화 & 노치/홈바 safe-area 대응 -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>미러핏 (MirrorFit) - AI 체형분석 & 스타일링</title>
  <!-- MediaPipe Pose 사람/신체 인식 AI 라이브러리 -->
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/pose/pose.js" crossorigin="anonymous"></script>
  <style>
    /* =========================================================
       미러핏 (MirrorFit) 단일 파일 일체형 스타일 시스템
       외부 종속성 제로 / 메일 첨부 및 모바일 최적화
       ========================================================= */

    :root {
      --primary-mint: #38c9b2;
      --primary-mint-dark: #20af9a;
      --primary-mint-light: #e6f9f6;
      --primary-mint-soft: #f0faf8;
      --primary-gradient: linear-gradient(135deg, #4de0c8 0%, #30c0ab 100%);
      --banner-gradient: linear-gradient(135deg, #6ceeda 0%, #35cbb4 100%);
      
      --white: #ffffff;
      --bg-page: #edf2f0;
      --bg-card: #ffffff;
      --text-main: #172421;
      --text-sub: #536461;
      --text-muted: #8c9e9a;
      --border-light: #e6eeec;
      --border-mint: #bcf0e8;
      
      --shadow-sm: 0 2px 8px rgba(25, 75, 68, 0.05);
      --shadow-md: 0 8px 24px rgba(25, 75, 68, 0.08);
      --shadow-mint: 0 8px 20px rgba(56, 201, 178, 0.32);
      
      --radius-sm: 10px;
      --radius-md: 16px;
      --radius-lg: 24px;
      --radius-full: 9999px;
      --transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Pretendard", "Malgun Gothic", sans-serif;
    }

    html, body {
      width: 100%;
      height: 100%;
      background-color: var(--bg-page);
      color: var(--text-main);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    body {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px 0;
    }

    /* =========================================================
       디바이스 프레임 (PC에서는 스마트폰 목업, 모바일에서는 100% 풀스크린 앱)
       ========================================================= */
    .app-container {
      width: 100%;
      max-width: 420px;
      height: 860px;
      background: var(--white);
      border-radius: 46px;
      box-shadow: 0 25px 60px rgba(18, 48, 42, 0.22), 0 0 0 10px #242928;
      position: relative;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* PC 전용 스마트폰 상단 노치 / 카메라 */
    .phone-notch {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 130px;
      height: 26px;
      background: #242928;
      border-bottom-left-radius: 16px;
      border-bottom-right-radius: 16px;
      z-index: 999;
      display: flex;
      justify-content: center;
      align-items: center;
      pointer-events: none;
    }
    .phone-speaker {
      width: 44px;
      height: 4px;
      background: #3b4240;
      border-radius: 2px;
    }
    .phone-camera-lens {
      width: 9px;
      height: 9px;
      background: #171d1c;
      border-radius: 50%;
      margin-left: 10px;
      border: 1px solid #303835;
    }

    /* PC 전용 스마트폰 하단 홈 바 */
    .phone-chin {
      position: absolute;
      bottom: 8px;
      left: 50%;
      transform: translateX(-50%);
      width: 130px;
      height: 4px;
      background: #1e2624;
      border-radius: 2px;
      z-index: 999;
      pointer-events: none;
      opacity: 0.3;
    }

    /* PC 상태바 (고선명 플래그십 모바일 시스템 스타일) */
    .status-bar {
      height: 42px;
      padding: 12px 22px 0 22px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14.5px;
      font-weight: 700;
      color: #081412;
      z-index: 100;
      user-select: none;
      background: transparent;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      transition: color 0.25s ease;
    }
    .status-bar #systemClock {
      letter-spacing: -0.3px;
      font-variant-numeric: tabular-nums;
      font-feature-settings: "tnum";
      line-height: 1;
    }
    .status-bar .icons {
      display: flex;
      gap: 7px;
      align-items: center;
      color: inherit;
    }
    .status-bar .icons svg {
      display: block;
      flex-shrink: 0;
    }
    /* 다크 화면(카메라 촬영 등) 진입 시 상태바 화이트 반전 */
    .status-bar.text-white {
      color: #ffffff !important;
    }

    /* PC 환경용 뷰 토글 버튼 */
    .view-mode-toggle {
      position: fixed;
      top: 18px;
      right: 18px;
      background: var(--white);
      padding: 8px 14px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 700;
      color: var(--primary-mint-dark);
      box-shadow: 0 4px 14px rgba(0,0,0,0.08);
      cursor: pointer;
      z-index: 1000;
      display: flex;
      align-items: center;
      gap: 6px;
      border: 1px solid var(--border-mint);
    }

    /* 데스크탑 와이드 모드 */
    body.full-mode {
      padding: 0;
      background: #f7faf9;
    }
    body.full-mode .app-container {
      max-width: 640px;
      height: 100vh;
      border-radius: 0;
      box-shadow: 0 0 40px rgba(0,0,0,0.06);
      border: none;
    }
    body.full-mode .phone-notch,
    body.full-mode .phone-chin {
      display: none;
    }

    /* =========================================================
       ⭐ 모바일(스마트폰) 환경 완벽 최적화 미디어 쿼리 ⭐
       메일이나 모바일 브라우저에서 열었을 때 실제 네이티브 앱처럼 100% 꽉 차게 표시
       ========================================================= */
    @media (max-width: 640px) {
      body {
        padding: 0 !important;
        background: var(--white) !important;
        align-items: stretch !important;
        height: 100% !important;
        min-height: 100% !important;
      }
      .app-container {
        max-width: 100% !important;
        width: 100% !important;
        height: 100vh !important;
        height: 100dvh !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        border: none !important;
      }
      .phone-notch,
      .phone-chin,
      .view-mode-toggle,
      .status-bar {
        display: none !important; /* 스마트폰 실제 시스템 UI가 있으므로 가짜 UI 숨김 */
      }
      .screen-viewport {
        height: 100% !important;
      }
    }

    /* =========================================================
       화면 라우터 시스템 (Screen Viewport)
       ========================================================= */
    .screen-viewport {
      flex: 1;
      position: relative;
      overflow: hidden;
      width: 100%;
      height: calc(100% - 40px);
    }

    .screen {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: none;
      flex-direction: column;
      background: var(--white);
      overflow-y: auto;
      overflow-x: hidden;
      opacity: 0;
      padding-bottom: 24px;
      -webkit-overflow-scrolling: touch;
    }
    .screen::-webkit-scrollbar {
      display: none;
    }
    .screen.active {
      display: flex;
      opacity: 1;
      z-index: 10;
    }

    /* 상단 공통 네비 헤더 */
    .nav-header {
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 16px;
      position: sticky;
      top: 0;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(8px);
      z-index: 50;
      border-bottom: 1px solid rgba(230, 238, 236, 0.7);
      flex-shrink: 0;
    }
    .btn-back {
      background: none;
      border: none;
      width: 38px;
      height: 38px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      border-radius: 50%;
      color: var(--text-main);
      transition: background 0.15s ease, transform 0.15s ease;
      flex-shrink: 0;
    }
    .btn-back:hover {
      background: rgba(0, 0, 0, 0.05);
    }
    .btn-back:active {
      transform: scale(0.92);
    }
    .header-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--text-main);
    }

    /* 공통 버튼 */
    .btn-primary {
      width: 100%;
      height: 52px;
      background: var(--primary-gradient);
      border: none;
      border-radius: var(--radius-full);
      color: var(--white);
      font-size: 16px;
      font-weight: 700;
      box-shadow: var(--shadow-mint);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: var(--transition);
      outline: none;
    }
    .btn-primary:active {
      transform: scale(0.98);
      filter: brightness(0.95);
    }
    .btn-secondary {
      width: 100%;
      height: 50px;
      background: var(--primary-mint-soft);
      color: var(--primary-mint-dark);
      border: 1.5px solid var(--border-mint);
      border-radius: var(--radius-full);
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
    }

    /* =========================================================
       [Step 1] 온보딩 / 스플래시 화면 (첨부 1)
       ========================================================= */
    #screen-splash {
      padding: 24px 24px 32px 24px;
      text-align: center;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
      background: radial-gradient(circle at 50% 25%, #f0fbf8 0%, #ffffff 80%);
    }
    .brand-logo-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--primary-mint-light);
      color: var(--primary-mint-dark);
      padding: 5px 12px;
      border-radius: var(--radius-full);
      font-size: 12px;
      font-weight: 800;
      margin-bottom: 10px;
    }
    .splash-title {
      font-size: 25px;
      font-weight: 800;
      line-height: 1.35;
      color: var(--text-main);
      letter-spacing: -0.5px;
    }
    .splash-logo-wrap {
      position: relative;
      margin: 15px auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .splash-logo-card {
      width: 220px;
      height: 220px;
      border-radius: 46px;
      box-shadow: 0 16px 36px rgba(32, 181, 159, 0.18), 0 4px 14px rgba(0, 0, 0, 0.05);
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      animation: floatSplashLogo 3.2s ease-in-out infinite;
      border: 1px solid rgba(220, 238, 234, 0.7);
    }
    @keyframes floatSplashLogo {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-7px); }
    }
    .splash-logo-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .splash-graphic-wrap {
      display: none;
    }
    .splash-desc {
      font-size: 14.5px;
      color: var(--text-sub);
      line-height: 1.5;
      margin-top: 8px;
      font-weight: 500;
    }
    .splash-desc strong {
      color: var(--primary-mint-dark);
      font-weight: 700;
    }
    .splash-btn-container {
      width: 100%;
      max-width: 320px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      margin-top: 12px;
      flex-shrink: 0;
    }
    .splash-start-btn {
      width: 100% !important;
      max-width: 270px !important;
      min-width: 220px !important;
      height: 52px !important;
      background: var(--primary-gradient) !important;
      border: none !important;
      border-radius: 26px !important;
      color: #ffffff !important;
      font-size: 16px !important;
      font-weight: 800 !important;
      letter-spacing: -0.3px !important;
      box-shadow: 0 8px 24px rgba(32, 181, 159, 0.38) !important;
      cursor: pointer !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 0 32px !important;
      box-sizing: border-box !important;
      white-space: nowrap !important;
      transition: var(--transition) !important;
      outline: none !important;
    }
    .splash-start-btn:active {
      transform: scale(0.97) !important;
      filter: brightness(0.96) !important;
    }
    .splash-dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 7px;
      margin-top: 14px;
    }
    .splash-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #d8e5e2;
    }
    .splash-dot.active {
      width: 20px;
      border-radius: 4px;
      background: var(--primary-mint);
    }

    /* =========================================================
       [Step 2-1] 로그인 화면
       ========================================================= */
    #screen-login {
      padding: 30px 24px;
      justify-content: center;
    }
    .login-header {
      text-align: center;
      margin-bottom: 30px;
    }
    .login-header h2 {
      font-size: 23px;
      font-weight: 800;
      color: var(--text-main);
      margin-bottom: 6px;
    }
    .login-header p {
      font-size: 13.5px;
      color: var(--text-sub);
    }
    .input-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
      text-align: left;
      margin-bottom: 14px;
    }
    .input-group label {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-sub);
    }
    .input-group input {
      height: 48px;
      padding: 0 16px;
      border-radius: var(--radius-md);
      border: 1.5px solid var(--border-light);
      font-size: 15px;
      outline: none;
    }
    .input-group input:focus {
      border-color: var(--primary-mint);
    }
    .social-divider {
      display: flex;
      align-items: center;
      color: var(--text-muted);
      font-size: 12px;
      margin: 16px 0;
    }
    .social-divider::before, .social-divider::after {
      content: '';
      flex: 1;
      border-bottom: 1px solid var(--border-light);
    }
    .social-divider span {
      padding: 0 10px;
    }
    .btn-kakao {
      height: 48px;
      border-radius: var(--radius-md);
      background: #fee500;
      color: #191600;
      border: none;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      margin-bottom: 10px;
    }
    .btn-naver {
      height: 48px;
      border-radius: var(--radius-md);
      background: #03c75a;
      color: var(--white);
      border: none;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
    }

    /* =========================================================
       [Step 2-2] 3대 체형 전문 가이드 화면
       ========================================================= */
    #screen-guide {
      padding: 0 0 24px 0;
    }
    .guide-box {
      padding: 18px 20px;
    }
    .body-type-tabs {
      display: flex;
      background: var(--primary-mint-soft);
      padding: 4px;
      border-radius: var(--radius-full);
      gap: 4px;
      margin: 16px 0;
      border: 1px solid var(--border-mint);
    }
    .body-tab-btn {
      flex: 1;
      padding: 9px 0;
      background: transparent;
      border: none;
      border-radius: var(--radius-full);
      font-size: 13.5px;
      font-weight: 700;
      color: var(--text-sub);
      cursor: pointer;
    }
    .body-tab-btn.active {
      background: var(--primary-mint);
      color: var(--white);
      box-shadow: 0 2px 8px rgba(56, 201, 178, 0.3);
    }
    .body-type-card {
      background: var(--white);
      border: 1.5px solid var(--border-light);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--shadow-sm);
      display: none;
    }
    .body-type-card.active {
      display: block;
    }
    .card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }
    .card-visual-box {
      width: 100%;
      height: 150px;
      background: linear-gradient(180deg, #f3fbf9 0%, #ffffff 100%);
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
      border: 1px dashed var(--border-mint);
    }
    .type-desc-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      font-size: 13.5px;
    }
    .desc-item {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      line-height: 1.45;
      color: var(--text-sub);
    }
    .desc-item .tag {
      background: #edf3f1;
      color: var(--text-main);
      font-size: 11px;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px;
      white-space: nowrap;
      margin-top: 1px;
    }

    /* =========================================================
       [Step 3] AI 3방향 사진 촬영 (전신 정면, 좌측면, 우측면)
       ========================================================= */
    #screen-capture {
      background: #0f1715;
      color: var(--white);
      padding: 0;
      position: relative;
    }

    /* 3방향 전환 탭 */
    .capture-angle-tabs {
      display: flex;
      gap: 6px;
      padding: 10px 14px;
      background: #141f1c;
      border-bottom: 1px solid rgba(56, 201, 178, 0.18);
      z-index: 30;
      flex-shrink: 0;
    }
    .angle-tab-btn {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 8px 6px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 12px;
      color: #9cb3ad;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .angle-tab-btn:hover {
      background: rgba(255, 255, 255, 0.09);
    }
    .angle-tab-btn.active {
      background: rgba(56, 201, 178, 0.18);
      border-color: var(--primary-mint);
      color: #ffffff;
      box-shadow: 0 0 14px rgba(56, 201, 178, 0.3);
    }
    .angle-tab-btn .tab-step-badge {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.16);
      color: #ffffff;
      font-size: 10.5px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      flex-shrink: 0;
    }
    .angle-tab-btn.active .tab-step-badge {
      background: var(--primary-mint);
      color: #0d1a17;
    }
    .angle-tab-btn.completed {
      border-color: rgba(56, 201, 178, 0.5);
      color: #ffffff;
    }
    .angle-tab-btn.completed .tab-step-badge {
      background: #38c9b2;
      color: #0c1815;
    }

    .camera-container {
      flex: 1;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      background: #0d1412;
      min-height: 380px;
    }
    .camera-preview-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      position: absolute;
      top: 0;
      left: 0;
    }
    .camera-crosshair {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 270px;
      height: 270px;
      border: 1px dashed rgba(56, 201, 178, 0.24);
      border-radius: 50%;
      pointer-events: none;
      animation: pulseCrosshair 4s infinite ease-in-out;
    }
    @keyframes pulseCrosshair {
      0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.45; }
      50% { transform: translate(-50%, -50%) scale(1.05); opacity: 0.85; }
    }

    /* 3방향 신체 가이드라인 SVG */
    .body-guide-wrap {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 200px;
      height: 360px;
      pointer-events: none;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 3;
    }
    .body-guide-svg {
      width: 100%;
      height: 100%;
      filter: drop-shadow(0 0 10px rgba(56, 201, 178, 0.7));
      transition: opacity 0.25s ease, transform 0.25s ease;
    }

    /* 4대 말풍선 핀 (각도별 유동 안내) */
    .pin-bubble {
      position: absolute;
      background: rgba(255, 255, 255, 0.95);
      color: #111a18;
      padding: 6px 12px;
      border-radius: 18px;
      font-size: 11.5px;
      font-weight: 800;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
      border: 1.5px solid var(--primary-mint);
      pointer-events: none;
      white-space: nowrap;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .pin-neck { top: 15%; right: 14px; }
    .pin-shoulder { top: 24%; left: 14px; }
    .pin-waist { top: 51%; left: 16px; }
    .pin-arm { top: 55%; right: 16px; }

    /* 3방향 썸네일 스트립 */
    .capture-thumb-strip {
      width: 100%;
      display: flex;
      gap: 8px;
      margin-bottom: 2px;
    }
    .thumb-slot {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      padding: 7px 6px;
      background: rgba(255, 255, 255, 0.04);
      border: 1.5px dashed rgba(255, 255, 255, 0.18);
      border-radius: 12px;
      cursor: pointer;
      position: relative;
      transition: all 0.2s ease;
    }
    .thumb-slot:hover {
      background: rgba(255, 255, 255, 0.08);
    }
    .thumb-slot.active {
      border-color: var(--primary-mint);
      border-style: solid;
      background: rgba(56, 201, 178, 0.12);
      box-shadow: 0 0 10px rgba(56, 201, 178, 0.25);
    }
    .thumb-slot.completed {
      border-style: solid;
      border-color: rgba(56, 201, 178, 0.6);
      background: rgba(56, 201, 178, 0.15);
    }
    .thumb-preview-box {
      width: 44px;
      height: 52px;
      border-radius: 8px;
      overflow: hidden;
      background: rgba(0, 0, 0, 0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }
    .thumb-preview-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .thumb-label {
      font-size: 11px;
      font-weight: 700;
      color: #9cb3ad;
      letter-spacing: -0.2px;
    }
    .thumb-slot.active .thumb-label {
      color: #ffffff;
    }
    .thumb-slot.completed .thumb-label {
      color: #38c9b2;
    }
    .thumb-check-icon {
      position: absolute;
      top: -4px;
      right: -4px;
      width: 18px;
      height: 18px;
      background: #38c9b2;
      color: #0c1815;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      font-weight: 900;
      box-shadow: 0 2px 6px rgba(0,0,0,0.4);
    }

    .capture-bottom-bar {
      background: #141f1c;
      padding: 12px 18px 22px 18px;
      border-top-left-radius: 24px;
      border-top-right-radius: 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
      border-top: 1px solid rgba(56, 201, 178, 0.16);
    }
    .capture-controls {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .btn-icon-sq {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.16);
      color: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
      transition: all 0.2s ease;
    }
    .btn-icon-sq:active {
      transform: scale(0.92);
      background: rgba(255, 255, 255, 0.14);
    }

    /* =========================================================
       [Step 4] 사전 설문조사 (첨부 3 우측)
       ========================================================= */
    #screen-survey {
      padding: 0 0 24px 0;
    }
    .survey-progress-box {
      padding: 12px 20px 0 20px;
    }
    .progress-meta {
      display: flex;
      justify-content: space-between;
      font-size: 12.5px;
      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 6px;
    }
    .progress-track {
      width: 100%;
      height: 6px;
      background: #e6eeec;
      border-radius: 3px;
      overflow: hidden;
    }
    .progress-fill {
      width: 33.3%;
      height: 100%;
      background: var(--primary-mint);
    }
    .survey-body {
      padding: 14px 20px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .survey-group {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .survey-label {
      font-size: 14px;
      font-weight: 700;
      color: var(--text-main);
    }
    .survey-label small {
      font-weight: 400;
      color: var(--text-muted);
    }
    .form-2col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .select-pill {
      position: relative;
    }
    .select-pill select {
      width: 100%;
      height: 46px;
      padding: 0 14px;
      border-radius: var(--radius-full);
      border: 1.5px solid var(--border-light);
      background: var(--white);
      font-size: 14px;
      font-weight: 600;
      outline: none;
      appearance: none;
    }
    .select-arrow {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
      font-size: 11px;
      color: var(--text-muted);
    }
    .chip-2col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }
    .chip-3col {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }
    .chip-btn {
      height: 46px;
      border-radius: var(--radius-full);
      border: 1.5px solid var(--border-light);
      background: var(--white);
      color: var(--text-sub);
      font-size: 13.5px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
    }
    .chip-btn.active {
      background: var(--primary-mint);
      border-color: var(--primary-mint);
      color: var(--white);
      box-shadow: 0 3px 10px rgba(56, 201, 178, 0.3);
    }

    /* =========================================================
       체형 정밀 진단 선택지 스타일
       ========================================================= */
    .survey-option-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .survey-option-btn {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      width: 100%;
      padding: 12px 14px;
      border-radius: 12px;
      border: 1.5px solid var(--border-light);
      background: var(--white);
      color: var(--text-main);
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      text-align: left;
      line-height: 1.5;
      transition: var(--transition);
    }
    .survey-option-btn:hover {
      border-color: var(--primary-mint);
      background: rgba(74,227,204,0.05);
    }
    .survey-option-btn.active {
      background: rgba(74,227,204,0.12);
      border-color: var(--primary-mint);
      color: var(--text-main);
      box-shadow: 0 2px 8px rgba(56,201,178,0.2);
    }
    .survey-option-badge {
      flex-shrink: 0;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--border-light);
      color: var(--text-sub);
      font-size: 11px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 1px;
      transition: var(--transition);
    }
    .survey-option-btn.active .survey-option-badge {
      background: var(--primary-mint);
      color: var(--white);
    }
    .survey-option-text {
      flex: 1;
    }

    /* =========================================================
       [Step 5-1] AI 분석 로딩 화면
       ========================================================= */
    #screen-loading {
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 30px;
      background: radial-gradient(circle at 50% 40%, #ebfaf7 0%, #ffffff 80%);
    }
    .radar-box {
      width: 200px;
      height: 200px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
    }
    .radar-circle {
      position: absolute;
      border-radius: 50%;
      border: 2px solid rgba(56, 201, 178, 0.25);
      animation: pulse 2s infinite ease-out;
    }
    .rc-1 { width: 90px; height: 90px; }
    .rc-2 { width: 150px; height: 150px; animation-delay: 0.5s; }
    .rc-3 { width: 200px; height: 200px; animation-delay: 1s; }
    .scan-beam {
      position: absolute;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, transparent 0%, var(--primary-mint) 50%, transparent 100%);
      top: 20%;
      animation: scan 2s infinite alternate ease-in-out;
    }
    @keyframes scan { 0% { top: 15%; } 100% { top: 85%; } }
    @keyframes pulse { 0% { transform: scale(0.85); opacity: 0.8; } 100% { transform: scale(1.15); opacity: 0; } }

    /* =========================================================
       [Step 5-2] AI 체형 분석 결과 화면
       ========================================================= */
    #screen-result {
      padding: 0 0 24px 0;
    }
    .result-top-banner {
      background: var(--banner-gradient);
      padding: 26px 20px 22px 20px;
      color: var(--white);
      border-bottom-left-radius: 28px;
      border-bottom-right-radius: 28px;
      box-shadow: var(--shadow-mint);
    }
    .result-wrap {
      padding: 18px 20px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .result-card {
      background: var(--white);
      border: 1.5px solid var(--border-light);
      border-radius: var(--radius-lg);
      padding: 18px;
      text-align: center;
      box-shadow: var(--shadow-sm);
    }
    .result-scores {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px solid var(--border-light);
    }
    .score-num {
      font-size: 16px;
      font-weight: 800;
      color: var(--primary-mint-dark);
    }
    .score-txt {
      font-size: 11px;
      color: var(--text-muted);
    }
    .fit-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .fit-box {
      padding: 14px;
      border-radius: var(--radius-md);
      font-size: 12px;
    }
    .fit-best { background: #f1fbf8; border: 1px solid var(--border-mint); }
    .fit-worst { background: #fff8f6; border: 1px solid #ffd8d2; }
    .fit-box ul { list-style: none; line-height: 1.6; color: var(--text-sub); }

    /* =========================================================
       [Step 6] 메인 홈 화면 - 세련된 프리미엄 모바일 UI 시스템 (참고 시안 반영)
       ========================================================= */
    #screen-home {
      padding: 16px 18px 84px 18px;
      background: #f8faf9;
    }
    #screen-home.active {
      display: block !important;
      opacity: 1 !important;
      z-index: 10 !important;
    }
    #screen-home > * {
      flex-shrink: 0 !important;
      box-sizing: border-box !important;
    }
    .home-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 14px;
      padding-top: 2px;
      width: 100%;
    }
    .home-sub-title {
      font-size: 11px;
      font-weight: 700;
      color: var(--primary-mint-dark);
      letter-spacing: -0.2px;
      margin-bottom: 3px;
    }
    .home-greeting {
      font-size: 18.5px;
      font-weight: 800;
      color: var(--text-main);
      letter-spacing: -0.4px;
      line-height: 1.3;
    }
    .home-greeting span {
      color: var(--primary-mint-dark);
    }
    .avatar-icon-btn {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1.5px solid var(--border-light);
      background: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-sub);
      cursor: pointer;
      box-shadow: 0 3px 10px rgba(25, 60, 52, 0.05);
      transition: var(--transition);
      flex-shrink: 0;
    }
    .avatar-icon-btn:active {
      transform: scale(0.94);
    }

    /* ⭐ [Step 6] 프리미엄 와이드 비주얼 배너 (AI 골격 분석 결과 완벽 노출) ⭐ */
    .home-banner {
      width: 100% !important;
      min-height: 156px !important;
      background: linear-gradient(135deg, #20b59f 0%, #179b88 100%) !important;
      border-radius: 20px !important;
      padding: 18px 18px 16px 18px !important;
      color: #ffffff !important;
      box-shadow: 0 10px 26px rgba(25, 175, 150, 0.28) !important;
      margin-bottom: 22px !important;
      position: relative !important;
      overflow: hidden !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 10px !important;
      box-sizing: border-box !important;
      visibility: visible !important;
      opacity: 1 !important;
      cursor: pointer;
    }
    .home-banner::after {
      content: '';
      position: absolute;
      top: -30px;
      right: -30px;
      width: 140px;
      height: 140px;
      background: rgba(255, 255, 255, 0.14);
      border-radius: 50%;
      pointer-events: none;
    }
    .home-banner::before {
      content: '';
      position: absolute;
      bottom: -40px;
      right: 40px;
      width: 90px;
      height: 90px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 50%;
      pointer-events: none;
    }
    .banner-top-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: relative;
      z-index: 2;
    }
    .banner-badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: rgba(255, 255, 255, 0.25);
      backdrop-filter: blur(6px);
      padding: 3.5px 10px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: -0.2px;
    }
    .banner-scan-tag {
      font-size: 10.5px;
      opacity: 0.92;
      font-weight: 600;
      letter-spacing: -0.2px;
    }
    .banner-title-text {
      font-size: 17.5px;
      font-weight: 800;
      line-height: 1.35;
      letter-spacing: -0.3px;
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
    }
    .banner-body-badge {
      font-size: 10.5px;
      font-weight: 800;
      background: rgba(0, 0, 0, 0.22);
      padding: 2.5px 8px;
      border-radius: 6px;
      letter-spacing: -0.2px;
    }
    .banner-sub-meta {
      font-size: 12px;
      opacity: 0.95;
      font-weight: 500;
      letter-spacing: -0.2px;
      position: relative;
      z-index: 2;
      line-height: 1.35;
    }
    .banner-fit-chips {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
      position: relative;
      z-index: 2;
      margin-top: 2px;
    }
    .banner-fit-chips .b-chip {
      background: rgba(255, 255, 255, 0.22);
      backdrop-filter: blur(4px);
      color: #ffffff;
      font-size: 10.5px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 6px;
      letter-spacing: -0.2px;
    }
    .banner-action-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      z-index: 2;
      margin-top: 4px;
      padding-top: 4px;
    }
    .banner-btn {
      display: inline-flex !important;
      align-items: center !important;
      gap: 6px !important;
      background: #ffffff !important;
      color: #128271 !important;
      font-size: 13.5px !important;
      font-weight: 800 !important;
      padding: 9px 18px !important;
      border-radius: var(--radius-full) !important;
      border: none !important;
      cursor: pointer !important;
      box-shadow: 0 4px 14px rgba(0,0,0,0.15) !important;
      transition: var(--transition) !important;
      white-space: nowrap !important;
      z-index: 5 !important;
    }
    .banner-btn:active {
      transform: scale(0.96) !important;
      filter: brightness(0.96) !important;
    }
    .banner-btn-hint {
      font-size: 11px;
      opacity: 0.9;
      font-weight: 600;
      cursor: pointer;
    }

    .home-sec-title {
      font-size: 15.5px;
      font-weight: 800;
      color: var(--text-main);
      margin-bottom: 10px;
      letter-spacing: -0.3px;
    }

    /* ⭐ 자주 찾는 메뉴 (Quick Menu - 균형 있는 크기와 정돈된 간격) ⭐ */
    .quick-menu-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 18px;
      padding: 0 4px;
    }
    .quick-menu-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      text-decoration: none;
      flex: 1;
      transition: transform 0.2s ease;
    }
    .quick-menu-item:active {
      transform: scale(0.92);
    }
    .quick-menu-circle {
      width: 48px;
      height: 48px;
      border-radius: 16px;
      background: var(--white);
      border: 1.5px solid rgba(220, 233, 230, 0.95);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 3px 12px rgba(25, 60, 52, 0.05);
      transition: var(--transition);
      position: relative;
    }
    .quick-menu-circle svg {
      width: 21px;
      height: 21px;
    }
    .quick-menu-item:hover .quick-menu-circle {
      border-color: var(--primary-mint);
      box-shadow: 0 5px 15px rgba(56, 201, 178, 0.2);
    }
    .quick-menu-label {
      font-size: 11.5px;
      font-weight: 700;
      color: var(--text-main);
      letter-spacing: -0.2px;
      text-align: center;
    }

    /* 기존 2x2 그리드 호환용 */
    .services-2x2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 26px;
    }
    .srv-card {
      background: var(--white);
      border-radius: 18px;
      padding: 16px 14px;
      border: 1px solid rgba(220, 230, 227, 0.85);
      box-shadow: 0 4px 16px rgba(25, 60, 52, 0.04);
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      transition: var(--transition);
      position: relative;
    }
    .srv-card:active {
      transform: scale(0.97);
      background: #fafcfb;
    }
    .srv-icon-wrap {
      width: 46px;
      height: 46px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
      flex-shrink: 0;
    }
    .srv-icon-analysis {
      background: linear-gradient(135deg, #e6f9f5 0%, #d1f5ee 100%);
      color: #1ea893;
    }
    .srv-icon-styling {
      background: linear-gradient(135deg, #f0f7ff 0%, #deedff 100%);
      color: #2b7fff;
    }
    .srv-icon-posture {
      background: linear-gradient(135deg, #f3fcf6 0%, #ddf6e6 100%);
      color: #1b9e59;
    }
    .srv-icon-market {
      background: linear-gradient(135deg, #fff3f0 0%, #ffe3dc 100%);
      color: #ff603d;
    }
    .srv-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .srv-title {
      font-size: 14.5px;
      font-weight: 800;
      color: var(--text-main);
      letter-spacing: -0.2px;
    }
    .srv-desc {
      font-size: 11.5px;
      color: var(--text-muted);
      font-weight: 500;
      letter-spacing: -0.2px;
    }

    /* 추천 아이템 가로 스크롤 */
    .scroll-row {
      display: flex;
      gap: 14px;
      overflow-x: auto;
      margin: 0 -18px;
      padding: 2px 18px 16px 18px;
      scrollbar-width: none;
    }
    .scroll-row::-webkit-scrollbar { display: none; }

    /* 무신사 & 에이블리 뱃지 및 쇼핑몰 전용 스타일 */
    .badge-mall {
      display: inline-flex;
      align-items: center;
      padding: 3px 6px;
      border-radius: 4px;
      font-size: 9.5px;
      font-weight: 800;
      letter-spacing: -0.2px;
      line-height: 1;
    }
    .badge-musinsa {
      background: #000000;
      color: #ffffff;
      box-shadow: 0 2px 6px rgba(0,0,0,0.25);
    }
    .badge-ably {
      background: #ff3358;
      color: #ffffff;
      box-shadow: 0 2px 6px rgba(255,51,88,0.3);
    }

    /* ⭐ 오늘의 추천 아이템 (컴팩트 이미지 & 레이아웃 균형 최적화) ⭐ */
    .product-card {
      flex: 0 0 120px;
      background: var(--white);
      border-radius: 14px;
      overflow: hidden;
      border: 1.5px solid rgba(220, 230, 227, 0.85);
      box-shadow: 0 3px 12px rgba(25, 60, 52, 0.05);
      cursor: pointer;
      position: relative;
      transition: all 0.25s ease;
      display: flex;
      flex-direction: column;
    }
    .product-card:active {
      transform: scale(0.97);
    }
    .product-card.selected {
      border-color: #20b59f;
      box-shadow: 0 4px 16px rgba(32, 181, 159, 0.35);
      background: #f7fdfb;
      transform: translateY(-2px);
    }
    .product-card.selected::before {
      content: '✓ 선택됨';
      position: absolute;
      top: 6px;
      right: 6px;
      background: #20b59f;
      color: #ffffff;
      font-size: 8px;
      font-weight: 800;
      padding: 2px 5px;
      border-radius: 10px;
      z-index: 5;
      letter-spacing: -0.2px;
      box-shadow: 0 2px 6px rgba(32, 181, 159, 0.4);
    }
    .product-img {
      width: 100%;
      height: 105px;
      background: #f1f5f4;
      position: relative;
      overflow: hidden;
    }
    .product-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }
    .product-card:hover .product-img img {
      transform: scale(1.04);
    }
    .product-img .mall-float-badge {
      position: absolute;
      top: 6px;
      left: 6px;
      z-index: 2;
      padding: 2.5px 5.5px;
      font-size: 8.5px;
      border-radius: 4px;
    }
    .btn-card-wish {
      position: absolute;
      top: 6px;
      right: 6px;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #8c9e9a;
      z-index: 2;
      border: none;
      cursor: pointer;
      transition: var(--transition);
    }
    .btn-card-wish:hover,
    .btn-card-wish.active {
      color: #ff3358;
      background: rgba(255, 240, 243, 0.95);
    }
    .product-meta {
      padding: 8px 9px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .product-tag {
      font-size: 9.5px;
      color: var(--primary-mint-dark);
      font-weight: 800;
      margin-bottom: 2px;
    }
    .product-brand {
      font-size: 10px;
      color: var(--text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-weight: 600;
    }
    .product-name {
      font-size: 11.5px;
      font-weight: 700;
      color: var(--text-main);
      line-height: 1.25;
      margin: 2px 0 5px 0;
      height: 28px;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
    .product-price-box {
      margin-top: auto;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
    }
    .product-price {
      font-size: 12.5px;
      font-weight: 800;
      color: var(--text-main);
    }
    .product-outlink-tag {
      margin-top: 5px;
      font-size: 9.5px;
      font-weight: 700;
      color: var(--primary-mint-dark);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 3px;
      background: var(--primary-mint-soft);
      padding: 3px 5px;
      border-radius: 5px;
      border: 1px solid var(--border-mint);
    }

    /* ⭐ 추천 의류 실제 상품 & 착용 핏 상세 뷰어 (추천 아이템 바로 아래) ⭐ */
    .product-real-preview-card {
      background: var(--white);
      border: 1px solid rgba(215, 230, 226, 0.9);
      border-radius: 16px;
      padding: 14px;
      margin-bottom: 18px;
      box-shadow: 0 4px 16px rgba(25, 60, 52, 0.05);
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: var(--transition);
      position: relative;
    }
    .real-preview-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .real-preview-badge {
      font-size: 9px;
      font-weight: 800;
      color: #ffffff;
      background: #111111;
      padding: 2.5px 6px;
      border-radius: 4px;
      letter-spacing: 0.5px;
    }
    .real-preview-mall {
      font-size: 10px;
      font-weight: 800;
      color: var(--text-muted);
    }
    .real-preview-fit-match {
      font-size: 10.5px;
      font-weight: 800;
      color: var(--primary-mint-dark);
      background: var(--primary-mint-soft);
      padding: 2.5px 7px;
      border-radius: 6px;
      border: 1px solid var(--border-mint);
    }
    .real-preview-gallery {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 8px;
      height: 145px;
      border-radius: 12px;
      overflow: hidden;
    }
    .real-preview-main-img,
    .real-preview-sub-img {
      position: relative;
      height: 100%;
      background: #f1f5f4;
      overflow: hidden;
    }
    .real-preview-main-img img,
    .real-preview-sub-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }
    .real-preview-main-img:hover img,
    .real-preview-sub-img:hover img {
      transform: scale(1.05);
    }
    .real-photo-badge {
      position: absolute;
      bottom: 6px;
      left: 6px;
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(4px);
      color: #ffffff;
      font-size: 8.5px;
      font-weight: 700;
      padding: 2px 5px;
      border-radius: 4px;
      pointer-events: none;
    }
    .real-preview-body {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .real-preview-brand {
      font-size: 10.5px;
      font-weight: 700;
      color: var(--text-muted);
    }
    .real-preview-title {
      font-size: 13.5px;
      font-weight: 800;
      color: var(--text-main);
      line-height: 1.3;
      letter-spacing: -0.2px;
    }
    .real-preview-desc-box {
      display: flex;
      align-items: flex-start;
      gap: 6px;
      background: #f7faf9;
      border: 1px solid rgba(220, 235, 230, 0.8);
      border-radius: 8px;
      padding: 8px 10px;
      font-size: 11px;
      color: var(--text-sub);
      line-height: 1.35;
      margin: 3px 0 5px 0;
    }
    .real-preview-desc-box svg {
      flex-shrink: 0;
      margin-top: 2px;
    }
    .real-preview-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 2px;
    }
    .real-preview-price {
      font-size: 15px;
      font-weight: 900;
      color: var(--text-main);
      margin-right: 6px;
    }
    .real-preview-discount {
      font-size: 11.5px;
      font-weight: 800;
      color: #ff3358;
    }
    .btn-real-preview-outlink {
      background: var(--text-main);
      color: var(--white);
      border: none;
      padding: 7px 12px;
      border-radius: 8px;
      font-size: 11.5px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: background 0.2s ease;
    }
    .btn-real-preview-outlink:active {
      background: #333333;
      transform: scale(0.97);
    }

    /* ⭐ 홈 화면 기획전 배너 ⭐ */
    .home-curation-banner {
      margin-bottom: 18px;
      background: linear-gradient(135deg, #fff7f4 0%, #ffece6 100%);
      border: 1px solid rgba(255, 96, 61, 0.2);
      border-radius: 14px;
      padding: 13px 15px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      transition: var(--transition);
      box-shadow: 0 3px 10px rgba(255, 96, 61, 0.06);
    }
    .home-curation-banner:active {
      transform: scale(0.98);
    }
    .curation-badge {
      display: inline-block;
      font-size: 9px;
      font-weight: 800;
      color: #ff5028;
      background: rgba(255, 96, 61, 0.12);
      padding: 2px 6px;
      border-radius: 4px;
      margin-bottom: 4px;
      letter-spacing: 0.3px;
    }
    .curation-title {
      font-size: 13.5px;
      font-weight: 800;
      color: var(--text-main);
      letter-spacing: -0.2px;
    }
    .curation-desc {
      font-size: 11px;
      color: var(--text-sub);
      margin-top: 2px;
    }

    /* ⭐ 홈 화면 미러핏 스타일 가이드 뉴스 ⭐ */
    .home-news-sec {
      margin-bottom: 16px;
    }
    .home-news-card {
      background: var(--white);
      border: 1px solid rgba(220, 230, 227, 0.85);
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 3px 12px rgba(25, 60, 52, 0.04);
      display: flex;
      flex-direction: column;
    }
    .home-news-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 13px;
      cursor: pointer;
      transition: background 0.2s ease;
    }
    .home-news-row:not(:last-child) {
      border-bottom: 1px solid rgba(230, 238, 236, 0.7);
    }
    .home-news-row:active {
      background: #f7faf9;
    }
    .news-thumb {
      width: 52px;
      height: 52px;
      border-radius: 10px;
      overflow: hidden;
      flex-shrink: 0;
      background: #f0f4f3;
    }
    .news-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .news-meta {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
    }
    .news-tag {
      font-size: 9.5px;
      font-weight: 800;
      color: var(--primary-mint-dark);
      margin-bottom: 2px;
    }
    .news-title {
      font-size: 12px;
      font-weight: 700;
      color: var(--text-main);
      line-height: 1.3;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .news-date {
      font-size: 10.5px;
      color: var(--text-muted);
      margin-top: 3px;
    }

    /* SHOP 전용 그리드 & 카드 */
    .shop-products-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 12px;
    }
    .shop-card {
      background: var(--white);
      border: 1px solid rgba(220, 230, 227, 0.85);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 4px 14px rgba(25, 60, 52, 0.04);
      cursor: pointer;
      display: flex;
      flex-direction: column;
      transition: var(--transition);
    }
    .shop-card:active {
      transform: scale(0.98);
    }
    .shop-card-img-wrap {
      width: 100%;
      height: 155px;
      position: relative;
      background: #f5f8f7;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .shop-card-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }
    .shop-card:hover .shop-card-img-wrap img {
      transform: scale(1.05);
    }
    .shop-card-badge {
      position: absolute;
      top: 8px;
      left: 8px;
      z-index: 2;
    }
    .shop-card-body {
      padding: 11px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .shop-card-brand {
      font-size: 10.5px;
      color: var(--text-muted);
      font-weight: 600;
    }
    .shop-card-title {
      font-size: 12.5px;
      font-weight: 700;
      color: var(--text-main);
      margin-top: 2px;
      line-height: 1.35;
      height: 34px;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
    .shop-card-match {
      font-size: 10px;
      font-weight: 800;
      color: var(--primary-mint-dark);
      background: var(--primary-mint-light);
      padding: 2px 6px;
      border-radius: 4px;
      display: inline-block;
      margin: 4px 0;
      width: fit-content;
    }
    .shop-card-price-row {
      display: flex;
      align-items: baseline;
      gap: 6px;
      margin-top: auto;
      padding-top: 6px;
    }
    .shop-card-discount {
      font-size: 13px;
      font-weight: 800;
      color: #ff3358;
    }
    .shop-card-price {
      font-size: 14px;
      font-weight: 800;
      color: var(--text-main);
    }
    .btn-shop-outlink {
      margin-top: 8px;
      width: 100%;
      height: 34px;
      border-radius: 8px;
      font-size: 11.5px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      border: none;
      cursor: pointer;
      transition: var(--transition);
      text-decoration: none;
    }
    .btn-shop-musinsa {
      background: #111111;
      color: #ffffff;
    }
    .btn-shop-musinsa:hover {
      background: #2b2b2b;
    }
    .btn-shop-ably {
      background: #ff3358;
      color: #ffffff;
    }
    .btn-shop-ably:hover {
      background: #ff5272;
    }

    /* 체형 연계 중고거래 카드 */
    .market-card-row {
      display: flex;
      gap: 14px;
      padding: 12px;
      background: var(--white);
      border: 1px solid rgba(220, 230, 227, 0.85);
      border-radius: 16px;
      cursor: pointer;
      box-shadow: 0 3px 12px rgba(25, 60, 52, 0.04);
      transition: var(--transition);
      align-items: center;
    }
    .market-card-row:active {
      transform: scale(0.98);
    }
    .market-thumb-wrap {
      width: 84px;
      height: 84px;
      border-radius: 12px;
      overflow: hidden;
      background: #edf4f2;
      flex-shrink: 0;
      position: relative;
    }
    .market-thumb-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* 하단 고정 탭바 */
    .nav-tab-bar {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 64px;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(10px);
      border-top: 1px solid var(--border-light);
      display: flex;
      align-items: center;
      justify-content: space-around;
      padding: 0 8px;
      z-index: 90;
    }
    .tab-item {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 10.5px;
      font-weight: 600;
      cursor: pointer;
    }
    .tab-item.active {
      color: var(--primary-mint);
    }

    /* =========================================================
       [Step 7-1 ~ 7-4] 4대 부가 서비스 화면 스타일
       ========================================================= */
    .sub-page-body {
      padding: 16px 20px 80px 20px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    /* 사진 가이드 화면: 스크롤 영역이 버튼 위까지만 차도록 flex 구조 활용 */
    #screen-photo-guide {
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    #screen-photo-guide .sub-page-body {
      flex: 1;
      overflow-y: auto;
      overflow-x: hidden;
      padding-bottom: 16px;
    }
    .info-card {
      background: var(--white);
      border: 1.5px solid var(--border-light);
      border-radius: var(--radius-lg);
      padding: 18px;
      box-shadow: var(--shadow-sm);
    }
    .dim-row {
      margin-bottom: 12px;
    }
    .dim-meta {
      display: flex;
      justify-content: space-between;
      font-size: 12.5px;
      font-weight: 700;
      margin-bottom: 5px;
    }
    .dim-track {
      width: 100%;
      height: 7px;
      background: #ebf2f0;
      border-radius: 4px;
      overflow: hidden;
    }
    .dim-bar {
      height: 100%;
      background: var(--primary-mint);
    }
    /* 스트레칭 루틴 */
    .routine-box {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px;
      background: var(--white);
      border: 1.5px solid var(--border-light);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
    }
    .routine-icon {
      width: 48px;
      height: 48px;
      border-radius: var(--radius-sm);
      background: var(--primary-mint-soft);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--primary-mint-dark);
      flex-shrink: 0;
    }
    /* 룩북 & 중고마켓 */
    .chip-scroll {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      scrollbar-width: none;
      margin: 0 -20px;
      padding: 0 20px;
    }
    .chip-scroll::-webkit-scrollbar { display: none; }
    .filter-chip {
      padding: 7px 14px;
      border-radius: var(--radius-full);
      background: #edf3f1;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--text-sub);
      border: none;
      cursor: pointer;
      white-space: nowrap;
    }
    .filter-chip.active {
      background: var(--primary-mint);
      color: var(--white);
    }
    .lookbook-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .look-card {
      background: var(--white);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      overflow: hidden;
      cursor: pointer;
    }
    .look-img {
      width: 100%;
      height: 160px;
      background: #edf3f1;
    }
    /* 토글 스위치 */
    .switch-ui {
      position: relative;
      display: inline-block;
      width: 42px;
      height: 24px;
    }
    .switch-ui input { opacity: 0; width: 0; height: 0; }
    .switch-slider {
      position: absolute;
      cursor: pointer;
      top: 0; left: 0; right: 0; bottom: 0;
      background: #cbd8d4;
      border-radius: 24px;
      transition: .25s;
    }
    .switch-slider:before {
      position: absolute;
      content: "";
      height: 18px;
      width: 18px;
      left: 3px;
      bottom: 3px;
      background: white;
      border-radius: 50%;
      transition: .25s;
    }
    input:checked + .switch-slider { background: var(--primary-mint); }
    input:checked + .switch-slider:before { transform: translateX(18px); }

    /* 모달 */
    .modal-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(15, 26, 24, 0.55);
      z-index: 500;
      display: none;
      align-items: flex-end;
    }
    .modal-overlay.active {
      display: flex;
    }
    .modal-popup {
      width: 100%;
      background: var(--white);
      border-top-left-radius: 24px;
      border-top-right-radius: 24px;
      padding: 22px;
      max-height: 80%;
      overflow-y: auto;
    }
  </style>
</head>
<body>

  <!-- PC 환경용 뷰 토글 -->
  <div class="view-mode-toggle" id="viewModeToggle">
    <span>전체 화면 모드</span>
  </div>

  <!-- 메인 모바일 앱 컨테이너 -->
  <div class="app-container" id="appContainer">

    <!-- PC 전용 상단 노치 -->
    <div class="phone-notch">
      <div class="phone-speaker"></div>
      <div class="phone-camera-lens"></div>
    </div>

    <!-- PC 전용 상태바 (고선명 플래그십 모바일 시스템) -->
    <div class="status-bar" id="appStatusBar">
      <span id="systemClock">09:41</span>
      <div class="icons">
        <!-- 셀룰러 네트워크 안테나 (고선명 4단 솔리드 바) -->
        <svg width="18" height="13" viewBox="0 0 18 13" fill="currentColor" aria-label="셀룰러 신호">
          <rect x="0.5" y="9.5" width="3.2" height="3.5" rx="0.9"/>
          <rect x="5.2" y="6.5" width="3.2" height="6.5" rx="0.9"/>
          <rect x="9.9" y="3.5" width="3.2" height="9.5" rx="0.9"/>
          <rect x="14.6" y="0.5" width="3.2" height="12.5" rx="0.9"/>
        </svg>

        <!-- 와이파이 (고선명 와이드 3단 아치 + 중심 도트) -->
        <svg width="19" height="13.5" viewBox="0 0 20 15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-label="와이파이">
          <path d="M1.2 3.5a14.5 14.5 0 0 1 17.6 0"/>
          <path d="M4.5 7.2a9.5 9.5 0 0 1 11 0"/>
          <path d="M7.8 10.8a4.8 4.8 0 0 1 4.4 0"/>
          <circle cx="10" cy="13.8" r="1.3" fill="currentColor" stroke="none"/>
        </svg>

        <!-- 배터리 (고선명 아웃라인 + 충전 레벨 + 팁) -->
        <svg width="25" height="12.5" viewBox="0 0 26 13" fill="none" aria-label="배터리">
          <rect x="0.8" y="0.8" width="21.5" height="11.4" rx="3.5" stroke="currentColor" stroke-width="1.8"/>
          <rect x="2.6" y="2.6" width="15.5" height="7.8" rx="2" fill="currentColor"/>
          <path d="M23.8 4.5c.7.4 1.2 1.1 1.2 2s-.5 1.6-1.2 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </div>
    </div>

    <!-- 메인 뷰포트 -->
    <div class="screen-viewport">

      <!-- ========================================================
           [Step 1] 온보딩 / 스플래시 화면 (MirrorFit 공식 브랜드 로고)
           ======================================================== -->
      <section class="screen active" id="screen-splash">
        <div style="margin-top:12px;">
          <div class="brand-logo-badge">MirrorFit AI</div>
          <h1 class="splash-title">내 손안의 퍼스널<br>스타일리스트</h1>
        </div>

        <!-- 미러핏 공식 심볼 & 로고 비주얼 카드 -->
        <div class="splash-logo-wrap">
          <div class="splash-logo-card">
            <img src="./mirrorfit-logo.png" onerror="this.onerror=null; this.src='mirrorfit-logo.png';" alt="MirrorFit Official Logo" class="splash-logo-img">
          </div>
        </div>

        <p class="splash-desc">
          <strong>AI 체형 분석</strong>으로 당신에게 꼭 맞는<br>
          핏(Fit)과 스타일을 찾아드립니다.
        </p>

        <div class="splash-btn-container">
          <button class="splash-start-btn" id="btnStartOnboarding" type="button">
            <span>시작하기</span>
          </button>
          <div class="splash-dots">
            <span class="splash-dot active"></span>
            <span class="splash-dot"></span>
            <span class="splash-dot"></span>
          </div>
        </div>
      </section>

      <!-- ========================================================
           [Step 2-1] 로그인 화면
           ======================================================== -->
      <section class="screen" id="screen-login">
        <div class="login-header">
          <div style="display:flex; justify-content:center; margin-bottom:10px;">
            <img src="./mirrorfit-logo.png" onerror="this.onerror=null; this.src='mirrorfit-logo.png';" style="width:52px; height:52px; border-radius:14px; box-shadow:0 6px 16px rgba(32,181,159,0.18); border:1px solid rgba(220,238,234,0.8);" alt="MirrorFit">
          </div>
          <h2>간편하게 시작하기</h2>
          <p>내 체형 분석 데이터를 안전하게 보관합니다</p>
        </div>

        <div style="margin-bottom:20px;">
          <div class="input-group">
            <label>닉네임 / 사용자 이름</label>
            <input type="text" id="userNameInput" value="미러핏" placeholder="이름을 입력하세요">
          </div>
          <div class="input-group">
            <label>이메일 계정</label>
            <input type="email" id="userEmailInput" value="official@mirrorfit.io" placeholder="official@mirrorfit.io">
          </div>
          <button class="btn-primary" id="btnLoginSubmit">미러핏으로 계속하기</button>
        </div>

        <div class="social-divider"><span>또는 간편 로그인</span></div>
        <button class="btn-kakao" id="btnKakaoLogin">카카오 1초 로그인</button>
        <button class="btn-naver" id="btnNaverLogin">네이버 아이디로 로그인</button>
      </section>

      <!-- ========================================================
           [Step 2-2] 3대 골격 체형 전문 가이드 화면
           ======================================================== -->
      <section class="screen" id="screen-guide">
        <header class="nav-header">
          <button class="btn-back" id="btnBackToLogin" aria-label="뒤로가기">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          </button>
          <span class="header-title">골격 체형 가이드</span>
          <div style="width:36px;"></div>
        </header>

        <div class="guide-box">
          <h3 style="font-size:19px; font-weight:800; text-align:center;">나의 타고난 골격 타입은?</h3>
          <p style="font-size:13px; color:var(--text-sub); text-align:center; margin-top:4px;">
            골격 구조와 볼륨 축에 따라 3대 체형으로 구분됩니다.
          </p>

          <!-- 3대 체형 탭 -->
          <div class="body-type-tabs">
            <button class="body-tab-btn active" data-tab="straight">스트레이트</button>
            <button class="body-tab-btn" data-tab="wave">웨이브</button>
            <button class="body-tab-btn" data-tab="natural">내추럴</button>
          </div>

          <!-- 스트레이트 카드 -->
          <div class="body-type-card active" id="tab-straight">
            <div class="card-head">
              <span style="font-size:18px; font-weight:800;">스트레이트 체형</span>
              <span class="brand-logo-badge" style="margin:0;">입체감 &amp; 탄력</span>
            </div>
            <div class="card-visual-box">
              <!-- 스트레이트: 균형 잡힌 상체 볼륨 & 높은 중심축 (정밀 인체 벡터) -->
              <svg width="110" height="150" viewBox="0 0 120 160" fill="none">
                <defs>
                  <linearGradient id="gradStraightBody" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#4ae3cc"/>
                    <stop offset="50%" stop-color="#28bda6"/>
                    <stop offset="100%" stop-color="#199984"/>
                  </linearGradient>
                  <linearGradient id="gradStraightGlow" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#38c9b2" stop-opacity="0.3"/>
                    <stop offset="100%" stop-color="#38c9b2" stop-opacity="0.0"/>
                  </linearGradient>
                  <filter id="straightGlow" x="-20%" y="-20%" width="140%" height="140%">
                    <feGaussianBlur stdDeviation="3" result="blur"/>
                    <feComposite in="SourceGraphic" in2="blur" operator="over"/>
                  </filter>
                </defs>
                <!-- 배경 바디 아우라 -->
                <ellipse cx="60" cy="80" rx="38" ry="65" fill="url(#gradStraightGlow)"/>
                
                <!-- 인체 실루엣 (스트레이트: 어깨≈골반 균형, 높은 바스트, 탄력 라인) -->
                <!-- 머리 & 목 -->
                <ellipse cx="60" cy="18" rx="10" ry="12" fill="url(#gradStraightBody)"/>
                <path d="M56 29 L56 37 L64 37 L64 29 Z" fill="url(#gradStraightBody)"/>

                <!-- 상체 및 몸통 -->
                <path d="M42 38 C47 36 53 36 60 36 C67 36 73 36 78 38 C83 40 85 45 84 52 C83 60 79 66 75 72 C73 75 71 82 72 90 C73 97 76 102 78 106 L42 106 C44 102 47 97 48 90 C49 82 47 75 45 72 C41 66 37 60 36 52 C35 45 37 40 42 38 Z" fill="url(#gradStraightBody)"/>

                <!-- 양팔 (자연스럽게 늘어뜨린 탄력 있는 팔) -->
                <path d="M35 44 C33 52 30 65 30 78 C30 88 32 98 33 105 C35 105 37 104 38 101 C36 94 35 84 36 76 C37 68 39 56 41 46 Z" fill="#22aa94"/>
                <path d="M85 44 C87 52 90 65 90 78 C90 88 88 98 87 105 C85 105 83 104 82 101 C84 94 85 84 84 76 C83 68 81 56 79 46 Z" fill="#22aa94"/>

                <!-- 하체 (허벅지 탄력, 곧게 뻗은 다리) -->
                <!-- 왼다리 -->
                <path d="M44 106 C45 116 47 128 47 138 C47 146 45 152 44 156 L55 156 C57 151 57 144 57 136 C57 126 56 116 57 106 Z" fill="#1b8e7c"/>
                <!-- 오른다리 -->
                <path d="M76 106 C75 116 73 128 73 138 C73 146 75 152 76 156 L65 156 C63 151 63 144 63 136 C63 126 64 116 63 106 Z" fill="#1b8e7c"/>

                <!-- 골격 랜드마크 분석 오버레이선 -->
                <!-- 어깨 밸런스 수평선 -->
                <line x1="36" y1="41" x2="84" y2="41" stroke="#ffffff" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.85"/>
                <!-- 바스트 포인트 중심축 -->
                <circle cx="51" cy="54" r="2.5" fill="#ffffff" filter="url(#straightGlow)"/>
                <circle cx="69" cy="54" r="2.5" fill="#ffffff" filter="url(#straightGlow)"/>
                <!-- 골반 수평선 -->
                <line x1="40" y1="104" x2="80" y2="104" stroke="#ffffff" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.85"/>
                <!-- 척추 중심선 -->
                <line x1="60" y1="36" x2="60" y2="106" stroke="#ffffff" stroke-width="1.2" stroke-dasharray="3 2" opacity="0.6"/>
              </svg>
            </div>
            <div class="type-desc-list">
              <div class="desc-item">
                <span class="tag">신체 특징</span>
                <span>상체 중심의 입체적인 볼륨감, 탄력 있는 피부결, 쇄골이 덜 도드라지고 허리 위치가 높음</span>
              </div>
              <div class="desc-item">
                <span class="tag">추천 스타일</span>
                <span>클래식 스탠다드 핏, V넥 셔츠, 일자 슬랙스, 각 잡힌 고급 코튼/울 소재</span>
              </div>
              <div class="desc-item">
                <span class="tag">피할 스타일</span>
                <span>과도한 퍼프 소매, 루즈핏 오버사이즈, 얇고 흐물거리는 소재</span>
              </div>
            </div>
          </div>

          <!-- 웨이브 카드 -->
          <div class="body-type-card" id="tab-wave">
            <div class="card-head">
              <span style="font-size:18px; font-weight:800;">웨이브 체형</span>
              <span class="brand-logo-badge" style="margin:0;">우아한 곡선미</span>
            </div>
            <div class="card-visual-box">
              <!-- 웨이브: 좁은 어깨, 긴 허리, 유려한 골반/하체 곡선 (정밀 인체 벡터) -->
              <svg width="110" height="150" viewBox="0 0 120 160" fill="none">
                <defs>
                  <linearGradient id="gradWaveBody" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#55e8d2"/>
                    <stop offset="50%" stop-color="#22baa2"/>
                    <stop offset="100%" stop-color="#148d79"/>
                  </linearGradient>
                  <linearGradient id="gradWaveGlow" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#20b59f" stop-opacity="0.3"/>
                    <stop offset="100%" stop-color="#20b59f" stop-opacity="0.0"/>
                  </linearGradient>
                  <filter id="waveGlow" x="-20%" y="-20%" width="140%" height="140%">
                    <feGaussianBlur stdDeviation="3" result="blur"/>
                    <feComposite in="SourceGraphic" in2="blur" operator="over"/>
                  </filter>
                </defs>
                <!-- 배경 바디 아우라 -->
                <ellipse cx="60" cy="85" rx="40" ry="65" fill="url(#gradWaveGlow)"/>

                <!-- 인체 실루엣 (웨이브: 가녀린 목, 좁은 어깨, 긴 허리, 넓은 골반 곡선) -->
                <!-- 머리 & 가녀리고 긴 목 -->
                <ellipse cx="60" cy="16" rx="9" ry="11" fill="url(#gradWaveBody)"/>
                <path d="M57 26 L57 37 L63 37 L63 26 Z" fill="url(#gradWaveBody)"/>

                <!-- 상체 및 골반 (슬림 상체 → 잘록한 허리 → 넓어지는 힙) -->
                <path d="M46 38 C49 37 54 37 60 37 C66 37 71 37 74 38 C79 40 80 46 78 54 C76 62 72 70 68 76 C66 80 65 85 66 90 C68 96 75 102 81 108 L39 108 C45 102 52 96 54 90 C55 85 54 80 52 76 C48 70 44 62 42 54 C40 46 41 40 46 38 Z" fill="url(#gradWaveBody)"/>

                <!-- 슬림한 양팔 -->
                <path d="M39 44 C37 52 35 65 35 78 C35 88 36 98 37 105 C38 105 40 104 41 101 C40 94 39 84 40 76 C41 68 43 56 44 46 Z" fill="#22aa94"/>
                <path d="M81 44 C83 52 85 65 85 78 C85 88 84 98 83 105 C82 105 80 104 79 101 C80 94 81 84 80 76 C79 68 77 56 76 46 Z" fill="#22aa94"/>

                <!-- 하체 (여성스러운 A라인 골반 & 부드러운 다리) -->
                <!-- 왼다리 -->
                <path d="M41 108 C43 118 45 130 45 140 C45 147 44 153 43 156 L54 156 C55 151 55 144 55 137 C55 127 54 117 55 108 Z" fill="#1b8e7c"/>
                <!-- 오른다리 -->
                <path d="M79 108 C77 118 75 130 75 140 C75 147 76 153 77 156 L66 156 C65 151 65 144 65 137 C65 127 66 117 65 108 Z" fill="#1b8e7c"/>

                <!-- 골격 랜드마크 분석 오버레이선 -->
                <!-- 쇄골 라인 뚜렷함 표시 -->
                <path d="M49 41 Q60 44 71 41" stroke="#ffffff" stroke-width="1.3" fill="none" opacity="0.9"/>
                <!-- 잘록한 허리 포인트 -->
                <line x1="51" y1="78" x2="69" y2="78" stroke="#ffffff" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.8"/>
                <!-- 하체 볼륨 중심축 (낮은 중심선) -->
                <line x1="36" y1="102" x2="84" y2="102" stroke="#ffffff" stroke-width="1.4" stroke-dasharray="2 2" opacity="0.9"/>
                <circle cx="39" cy="102" r="2.5" fill="#ffffff" filter="url(#waveGlow)"/>
                <circle cx="81" cy="102" r="2.5" fill="#ffffff" filter="url(#waveGlow)"/>
              </svg>
            </div>
            <div class="type-desc-list">
              <div class="desc-item">
                <span class="tag">신체 특징</span>
                <span>가녀린 상체와 긴 목선, 뚜렷한 쇄골, 허리선이 길고 힙 볼륨이 하체에 집중</span>
              </div>
              <div class="desc-item">
                <span class="tag">추천 스타일</span>
                <span>하이웨이스트, 크롭 상의, 부드러운 쉬폰/트위드, A라인 스커트</span>
              </div>
              <div class="desc-item">
                <span class="tag">피할 스타일</span>
                <span>깊게 파인 V넥, 긴 로우웨이스트, 무겁고 뻣뻣한 데님</span>
              </div>
            </div>
          </div>

          <!-- 내추럴 카드 -->
          <div class="body-type-card" id="tab-natural">
            <div class="card-head">
              <span style="font-size:18px; font-weight:800;">내추럴 체형</span>
              <span class="brand-logo-badge" style="margin:0;">스타일리시 골격</span>
            </div>
            <div class="card-visual-box">
              <!-- 내추럴: 넓은 어깨 프레임, 시크한 직선 골격 (정밀 인체 벡터) -->
              <svg width="110" height="150" viewBox="0 0 120 160" fill="none">
                <defs>
                  <linearGradient id="gradNaturalBody" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#5ff0d8"/>
                    <stop offset="50%" stop-color="#2fc9b2"/>
                    <stop offset="100%" stop-color="#189d87"/>
                  </linearGradient>
                  <linearGradient id="gradNaturalGlow" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#4fe0c8" stop-opacity="0.3"/>
                    <stop offset="100%" stop-color="#4fe0c8" stop-opacity="0.0"/>
                  </linearGradient>
                  <filter id="naturalGlow" x="-20%" y="-20%" width="140%" height="140%">
                    <feGaussianBlur stdDeviation="3" result="blur"/>
                    <feComposite in="SourceGraphic" in2="blur" operator="over"/>
                  </filter>
                </defs>
                <!-- 배경 바디 아우라 -->
                <ellipse cx="60" cy="80" rx="42" ry="65" fill="url(#gradNaturalGlow)"/>

                <!-- 인체 실루엣 (내추럴: 돋보이는 어깨 프레임, 박시한 몸통, 긴 라인) -->
                <!-- 머리 & 목 -->
                <ellipse cx="60" cy="17" rx="10" ry="12" fill="url(#gradNaturalBody)"/>
                <path d="M55 28 L55 36 L65 36 L65 28 Z" fill="url(#gradNaturalBody)"/>

                <!-- 상체 및 몸통 (넓고 각진 어깨 → 일자로 떨어지는 프레임 실루엣) -->
                <path d="M37 38 C44 36 52 36 60 36 C68 36 76 36 83 38 C89 40 90 46 88 54 C86 63 82 72 79 80 C77 86 76 94 77 106 L43 106 C44 94 43 86 41 80 C38 72 34 63 32 54 C30 46 31 40 37 38 Z" fill="url(#gradNaturalBody)"/>

                <!-- 길고 프레임 있는 양팔 -->
                <path d="M30 42 C27 52 26 66 26 80 C26 90 28 100 29 108 C31 108 33 107 34 104 C32 96 31 85 32 76 C33 67 36 54 38 45 Z" fill="#22aa94"/>
                <path d="M90 42 C93 52 94 66 94 80 C94 90 92 100 91 108 C89 108 87 107 86 104 C88 96 89 85 88 76 C87 67 84 54 82 45 Z" fill="#22aa94"/>

                <!-- 긴 하체 (관절 프레임 강조) -->
                <!-- 왼다리 -->
                <path d="M43 106 C44 117 45 129 45 139 C45 147 43 153 42 156 L54 156 C56 151 57 144 57 136 C57 126 56 116 57 106 Z" fill="#1b8e7c"/>
                <!-- 오른다리 -->
                <path d="M77 106 C76 117 75 129 75 139 C75 147 77 153 78 156 L66 156 C64 151 63 144 63 136 C63 126 64 116 63 106 Z" fill="#1b8e7c"/>

                <!-- 골격 랜드마크 분석 오버레이선 -->
                <!-- 넓은 어깨 프레임 수평선 -->
                <line x1="30" y1="39" x2="90" y2="39" stroke="#ffffff" stroke-width="1.6" stroke-dasharray="2 2" opacity="0.95"/>
                <circle cx="33" cy="39" r="3" fill="#ffffff" filter="url(#naturalGlow)"/>
                <circle cx="87" cy="39" r="3" fill="#ffffff" filter="url(#naturalGlow)"/>
                <!-- 쇄골 뼈대 라인 -->
                <line x1="42" y1="42" x2="78" y2="42" stroke="#ffffff" stroke-width="1.2" opacity="0.85"/>
                <!-- 박시한 흉곽 프레임 -->
                <rect x="42" y="50" width="36" height="30" rx="3" stroke="#ffffff" stroke-width="1.1" stroke-dasharray="2 2" fill="none" opacity="0.6"/>
              </svg>
            </div>
            <div class="type-desc-list">
              <div class="desc-item">
                <span class="tag">신체 특징</span>
                <span>어깨 관절과 골격 프레임이 또렷함, 신체 라인이 중성적이고 긴 편</span>
              </div>
              <div class="desc-item">
                <span class="tag">추천 스타일</span>
                <span>오버사이즈 자켓, 롱 와이드 팬츠, 린넨/코듀로이 등 내추럴한 질감</span>
              </div>
              <div class="desc-item">
                <span class="tag">피할 스타일</span>
                <span>타이트하게 달라붙는 스키니핏, 화려하고 작은 악세사리</span>
              </div>
            </div>
          </div>

          <button class="btn-primary" id="btnStartCapture" style="margin-top:20px;">다음 (내 체형 분석하기)</button>
        </div>
      </section>

      <!-- ========================================================
           [Step 2-5] 촬영 가이드 화면 (사진 촬영 전 안내)
           ======================================================== -->
      <section class="screen" id="screen-photo-guide">
        <header class="nav-header">
          <button class="btn-back" id="btnBackFromPhotoGuide" aria-label="뒤로가기">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          </button>
          <span class="header-title">분석을 위한 사진 가이드</span>
          <div style="width:36px;"></div>
        </header>

        <div class="sub-page-body" style="padding:0 0 16px;">

          <!-- 상단 팁 카드 -->
          <div style="padding:20px 18px 4px;">
            <div style="background:#fff; border-radius:16px; padding:18px 16px; box-shadow:var(--shadow-md); border:1px solid var(--border-mint);">
              <div style="font-size:17px; font-weight:800; color:var(--text-main); margin-bottom:14px; text-align:center;">📸 분석을 위한 팁</div>
              <div style="display:flex; flex-direction:column; gap:12px;">
                <div style="display:flex; align-items:flex-start; gap:12px;">
                  <span style="font-size:22px; flex-shrink:0;">🗂️</span>
                  <span style="font-size:14px; color:var(--text-sub); line-height:1.5;">전신이 잘 보이는 사진을 선택하세요</span>
                </div>
                <div style="display:flex; align-items:flex-start; gap:12px;">
                  <span style="font-size:22px; flex-shrink:0;">🧍</span>
                  <span style="font-size:14px; color:var(--text-sub); line-height:1.5;">정면을 보고 서있는 자세가 좋습니다</span>
                </div>
                <div style="display:flex; align-items:flex-start; gap:12px;">
                  <span style="font-size:22px; flex-shrink:0;">💡</span>
                  <span style="font-size:14px; color:var(--text-sub); line-height:1.5;">밝은 배경에서 촬영된 사진을 권장합니다</span>
                </div>
                <div style="display:flex; align-items:flex-start; gap:12px;">
                  <span style="font-size:22px; flex-shrink:0;">👕</span>
                  <span style="font-size:14px; color:var(--text-sub); line-height:1.5;">몸의 라인이 잘 보이는 옷을 입으세요</span>
                </div>
              </div>
            </div>
          </div>

          <!-- 상세 가이드 카드 -->
          <div style="padding:0 18px; display:flex; flex-direction:column; gap:12px;">

            <!-- 필수 조건 -->
            <div style="background:#fff; border-radius:14px; padding:16px 16px; box-shadow:var(--shadow-sm); border:1px solid var(--border-light);">
              <div style="display:flex; align-items:center; gap:7px; margin-bottom:10px;">
                <span style="font-size:16px;">🚨</span>
                <span style="font-size:14px; font-weight:800; color:#e53935;">필수 조건</span>
              </div>
              <div style="display:flex; flex-direction:column; gap:6px; padding-left:4px;">
                <div style="font-size:13px; color:var(--text-sub); line-height:1.5;">• 반드시 한 명만 촬영 (여러 명 X)</div>
                <div style="font-size:13px; color:var(--text-sub); line-height:1.5;">• 전신이 모두 보이는 사진</div>
                <div style="font-size:13px; color:var(--text-sub); line-height:1.5;">• 얼굴과 몸 전체가 선명하게 보일 것</div>
                <div style="font-size:13px; font-weight:700; color:#e53935; line-height:1.5; background:#fff5f5; padding:7px 10px; border-radius:8px; border-left:3px solid #e53935; margin-top:4px;">
                  👗 몸의 전체적인 라인이 잘 드러나는<br>몸에 밀착되는 옷을 착용해 주세요
                </div>
              </div>
            </div>

            <!-- 촬영 자세 -->
            <div style="background:#fff; border-radius:14px; padding:16px 16px; box-shadow:var(--shadow-sm); border:1px solid var(--border-light);">
              <div style="display:flex; align-items:center; gap:7px; margin-bottom:10px;">
                <span style="font-size:16px;">🗂️</span>
                <span style="font-size:14px; font-weight:800; color:var(--text-main);">촬영 자세</span>
              </div>
              <div style="display:flex; flex-direction:column; gap:6px; padding-left:4px;">
                <div style="font-size:13px; color:var(--text-sub); line-height:1.5;">• 정면을 보고 똑바로 서기</div>
                <div style="font-size:13px; color:var(--text-sub); line-height:1.5;">• 팔은 자연스럽게 양옆으로</div>
                <div style="font-size:13px; color:var(--text-sub); line-height:1.5;">• 다리는 어깨 너비로 벌리기</div>
                <div style="font-size:13px; color:var(--text-sub); line-height:1.5;">• 머리부터 발끝까지 모두 포함</div>
              </div>
            </div>

            <!-- 촬영 환경 -->
            <div style="background:#fff; border-radius:14px; padding:16px 16px; box-shadow:var(--shadow-sm); border:1px solid var(--border-light);">
              <div style="display:flex; align-items:center; gap:7px; margin-bottom:10px;">
                <span style="font-size:16px;">💡</span>
                <span style="font-size:14px; font-weight:800; color:var(--text-main);">촬영 환경</span>
              </div>
              <div style="display:flex; flex-direction:column; gap:6px; padding-left:4px;">
                <div style="font-size:13px; color:var(--text-sub); line-height:1.5;">• 밝은 조명 (자연광 권장)</div>
                <div style="font-size:13px; color:var(--text-sub); line-height:1.5;">• 단색 배경 (흰색, 회색 등)</div>
                <div style="font-size:13px; color:var(--text-sub); line-height:1.5;">• 카메라와 2~3m 거리</div>
                <div style="font-size:13px; color:var(--text-sub); line-height:1.5;">• 카메라 높이는 가슴 높이</div>
              </div>
            </div>

            <!-- 피해야 할 것들 -->
            <div style="background:var(--primary-mint-soft); border-radius:14px; padding:16px 16px; box-shadow:var(--shadow-sm); border:1px solid var(--border-mint);">
              <div style="display:flex; align-items:center; gap:7px; margin-bottom:10px;">
                <span style="font-size:16px;">❌</span>
                <span style="font-size:14px; font-weight:800; color:#e53935;">피해야 할 것들</span>
              </div>
              <div style="display:flex; flex-direction:column; gap:6px; padding-left:4px;">
                <div style="font-size:13px; color:#c0392b; line-height:1.5;">• 여러 명이 함께 찍힌 사진</div>
                <div style="font-size:13px; color:#c0392b; line-height:1.5;">• 몸의 일부가 잘린 사진</div>
                <div style="font-size:13px; color:#c0392b; line-height:1.5;">• 너무 어둡거나 흐린 사진</div>
                <div style="font-size:13px; color:#c0392b; line-height:1.5;">• 옆모습이나 뒷모습 사진</div>
                <div style="font-size:13px; color:#c0392b; line-height:1.5;">• 몸 라인이 가려지는 헐렁한 옷</div>
              </div>
            </div>

          </div>
        </div>

        <!-- 하단 고정 촬영 시작 버튼 -->
        <div style="flex-shrink:0; padding:12px 18px 28px; background:#fff; border-top:1px solid var(--border-mint);">
          <button class="btn-primary" id="btnGoToCapture" style="width:100%; height:52px; font-size:15.5px; font-weight:800;">
            📷 사진 촬영 시작하기
          </button>
        </div>
      </section>

      <!-- ========================================================
           [Step 3] AI 3방향 사진 촬영 / 첨부 (전신 정면, 좌측면, 우측면)
           ======================================================== -->
      <section class="screen" id="screen-capture">
        <header class="nav-header" style="background:#141f1c; border-bottom:1px solid rgba(56,201,178,0.2);">
          <button class="btn-back" id="btnBackToGuide" style="color:#ffffff;" aria-label="뒤로가기">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          </button>
          <span class="header-title" style="color:#ffffff;">체형 분석 3방향 촬영</span>
          <div style="width:36px;"></div>
        </header>

        <!-- 3방향 전환 탭 (전신 정면 / 좌측면 / 우측면) -->
        <div class="capture-angle-tabs">
          <button class="angle-tab-btn active" id="tabAngleFront" data-angle="front">
            <span class="tab-step-badge" id="badgeStepFront">1</span>
            <span>전신 (정면)</span>
          </button>
          <button class="angle-tab-btn" id="tabAngleLeft" data-angle="left">
            <span class="tab-step-badge" id="badgeStepLeft">2</span>
            <span>좌측면</span>
          </button>
          <button class="angle-tab-btn" id="tabAngleRight" data-angle="right">
            <span class="tab-step-badge" id="badgeStepRight">3</span>
            <span>우측면</span>
          </button>
        </div>

        <!-- 카메라 뷰 및 각도별 가이드라인 -->
        <div class="camera-container">
          <!-- 웹캠/카메라 라이브 스트림 비디오 -->
          <video id="cameraLiveVideo" autoplay playsinline muted style="display:none; width:100%; height:100%; object-fit:cover; position:absolute; top:0; left:0; z-index:1;"></video>
          <canvas id="cameraCanvas" style="display:none;"></canvas>
          <!-- MediaPipe 실시간 인체 랜드마크 스켈레톤 오버레이 캔버스 -->
          <canvas id="mediapipeOverlayCanvas" style="display:none; width:100%; height:100%; position:absolute; top:0; left:0; z-index:2; pointer-events:none;"></canvas>

          <!-- 촬영/선택된 사진 프리뷰 -->
          <img class="camera-preview-img" id="cameraPreviewImg" src="" alt="미리보기" style="display:none; z-index:2;">

          <div class="camera-crosshair" style="z-index:3;"></div>

          <!-- 3방향 전용 신체 와이어프레임 가이드 래퍼 -->
          <div class="body-guide-wrap" id="bodyGuideWrap">
            <!-- 1. 전신 (정면) 가이드 SVG -->
            <svg class="body-guide-svg" id="guideSvgFront" viewBox="0 0 100 220" fill="none">
              <!-- 머리 & 목 -->
              <ellipse cx="50" cy="22" rx="12" ry="14" stroke="#38c9b2" stroke-width="1.8" fill="rgba(56,201,178,0.08)" stroke-dasharray="3 2"/>
              <!-- 어깨 수평선 -->
              <line x1="18" y1="46" x2="82" y2="46" stroke="#38c9b2" stroke-width="1.6" stroke-dasharray="2 2" opacity="0.9"/>
              <circle cx="24" cy="46" r="2.5" fill="#38c9b2"/>
              <circle cx="76" cy="46" r="2.5" fill="#38c9b2"/>
              <!-- 양팔 가이드 -->
              <path d="M22 48 C16 70 14 95 16 115 C18 115 20 114 21 110 C21 95 24 72 28 52 Z" stroke="#38c9b2" stroke-width="1.6" fill="rgba(56,201,178,0.06)" stroke-dasharray="3 2"/>
              <path d="M78 48 C84 70 86 95 84 115 C82 115 80 114 79 110 C79 95 76 72 72 52 Z" stroke="#38c9b2" stroke-width="1.6" fill="rgba(56,201,178,0.06)" stroke-dasharray="3 2"/>
              <!-- 몸통 윤곽선 -->
              <path d="M30 46 C38 43 45 43 50 43 C55 43 62 43 70 46 C75 52 76 66 73 78 C71 86 73 96 74 108 L26 108 C27 96 29 86 27 78 C24 66 25 52 30 46 Z" stroke="#38c9b2" stroke-width="1.8" fill="rgba(56,201,178,0.08)" stroke-dasharray="3 2"/>
              <!-- 허리 & 골반 수평선 -->
              <line x1="28" y1="76" x2="72" y2="76" stroke="#38c9b2" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.75"/>
              <line x1="24" y1="106" x2="76" y2="106" stroke="#38c9b2" stroke-width="1.6" stroke-dasharray="2 2" opacity="0.9"/>
              <circle cx="28" cy="106" r="2.5" fill="#38c9b2"/>
              <circle cx="72" cy="106" r="2.5" fill="#38c9b2"/>
              <!-- 중앙 수직 정렬선 (Plumb line) -->
              <line x1="50" y1="8" x2="50" y2="210" stroke="#38c9b2" stroke-width="1.2" stroke-dasharray="4 3" opacity="0.6"/>
              <!-- 양 다리 -->
              <path d="M30 108 C32 135 33 165 33 205 L44 205 C46 165 47 135 48 108 Z" stroke="#38c9b2" stroke-width="1.8" fill="rgba(56,201,178,0.06)"/>
              <path d="M70 108 C68 135 67 165 67 205 L56 205 C54 165 53 135 52 108 Z" stroke="#38c9b2" stroke-width="1.8" fill="rgba(56,201,178,0.06)"/>
            </svg>

            <!-- 2. 좌측면 가이드 SVG (숨김 기본) -->
            <svg class="body-guide-svg" id="guideSvgLeft" viewBox="0 0 100 220" fill="none" style="display:none;">
              <!-- 머리 & 턱선 (왼쪽 응시) -->
              <path d="M48 10 C38 10 32 18 34 26 C35 30 38 34 44 36 L44 45 L54 45 L54 36 C60 34 64 26 62 18 C60 12 55 10 48 10 Z" stroke="#38c9b2" stroke-width="1.8" fill="rgba(56,201,178,0.08)" stroke-dasharray="3 2"/>
              <!-- 측면 척추 정렬 S커브선 (경추-흉추-요추-천골) -->
              <path d="M50 36 Q44 48 48 64 Q54 82 46 98 Q42 110 48 116" stroke="#38c9b2" stroke-width="2" fill="none" opacity="0.95"/>
              <!-- 가슴 & 복부 측면 윤곽선 -->
              <path d="M38 46 C34 56 32 68 36 78 C38 84 37 92 35 106 C40 114 55 116 62 106 C64 94 62 76 56 60 C53 50 46 44 38 46 Z" stroke="#38c9b2" stroke-width="1.8" fill="rgba(56,201,178,0.08)" stroke-dasharray="3 2"/>
              <!-- 측면 팔 라인 -->
              <path d="M44 48 C42 68 41 90 42 112 C45 112 47 111 48 108 C47 90 48 70 50 50 Z" stroke="#38c9b2" stroke-width="1.6" fill="rgba(56,201,178,0.06)" stroke-dasharray="3 2"/>
              <!-- 측면 다리 라인 -->
              <path d="M36 106 C38 135 40 165 42 205 L56 205 C54 165 58 135 60 106 Z" stroke="#38c9b2" stroke-width="1.8" fill="rgba(56,201,178,0.06)"/>
              <!-- 수직 바른자세 기준선 (귀-어깨-골반-복사뼈) -->
              <line x1="48" y1="8" x2="48" y2="210" stroke="#ffffff" stroke-width="1.2" stroke-dasharray="4 3" opacity="0.75"/>
              <circle cx="48" cy="26" r="3" fill="#ffffff"/>
              <circle cx="48" cy="48" r="3" fill="#ffffff"/>
              <circle cx="48" cy="106" r="3" fill="#ffffff"/>
              <circle cx="48" cy="160" r="3" fill="#ffffff"/>
              <circle cx="48" cy="202" r="3" fill="#ffffff"/>
            </svg>

            <!-- 3. 우측면 가이드 SVG (숨김 기본) -->
            <svg class="body-guide-svg" id="guideSvgRight" viewBox="0 0 100 220" fill="none" style="display:none;">
              <!-- 머리 & 턱선 (오른쪽 응시) -->
              <path d="M52 10 C62 10 68 18 66 26 C65 30 62 34 56 36 L56 45 L46 45 L46 36 C40 34 36 26 38 18 C40 12 45 10 52 10 Z" stroke="#38c9b2" stroke-width="1.8" fill="rgba(56,201,178,0.08)" stroke-dasharray="3 2"/>
              <!-- 측면 척추 정렬 S커브선 (대칭) -->
              <path d="M50 36 Q56 48 52 64 Q46 82 54 98 Q58 110 52 116" stroke="#38c9b2" stroke-width="2" fill="none" opacity="0.95"/>
              <!-- 가슴 & 복부 측면 윤곽선 -->
              <path d="M62 46 C66 56 68 68 64 78 C62 84 63 92 65 106 C60 114 45 116 38 106 C36 94 38 76 44 60 C47 50 54 44 62 46 Z" stroke="#38c9b2" stroke-width="1.8" fill="rgba(56,201,178,0.08)" stroke-dasharray="3 2"/>
              <!-- 측면 팔 라인 -->
              <path d="M56 48 C58 68 59 90 58 112 C55 112 53 111 52 108 C53 90 52 70 50 50 Z" stroke="#38c9b2" stroke-width="1.6" fill="rgba(56,201,178,0.06)" stroke-dasharray="3 2"/>
              <!-- 측면 다리 라인 -->
              <path d="M64 106 C62 135 60 165 58 205 L44 205 C46 165 42 135 40 106 Z" stroke="#38c9b2" stroke-width="1.8" fill="rgba(56,201,178,0.06)"/>
              <!-- 수직 바른자세 기준선 -->
              <line x1="52" y1="8" x2="52" y2="210" stroke="#ffffff" stroke-width="1.2" stroke-dasharray="4 3" opacity="0.75"/>
              <circle cx="52" cy="26" r="3" fill="#ffffff"/>
              <circle cx="52" cy="48" r="3" fill="#ffffff"/>
              <circle cx="52" cy="106" r="3" fill="#ffffff"/>
              <circle cx="52" cy="160" r="3" fill="#ffffff"/>
              <circle cx="52" cy="202" r="3" fill="#ffffff"/>
            </svg>
          </div>

          <!-- 유동 말풍선 핀 4종 -->
          <div class="pin-bubble pin-neck" id="pinNeck" style="z-index:4;">목 둘레, 목 길이</div>
          <div class="pin-bubble pin-shoulder" id="pinShoulder" style="z-index:4;">어깨 너비</div>
          <div class="pin-bubble pin-waist" id="pinWaist" style="z-index:4;">허리 라인</div>
          <div class="pin-bubble pin-arm" id="pinArm" style="z-index:4;">팔 길이</div>

          <!-- 촬영 모드 및 MediaPipe 사람 인식 상태 안내 뱃지 -->
          <div id="cameraStatusBadge" style="position:absolute; top:12px; left:14px; background:rgba(0,0,0,0.72); color:#38c9b2; padding:6px 12px; border-radius:14px; font-size:11.5px; font-weight:700; z-index:5; display:flex; align-items:center; gap:6px; border:1px solid rgba(56,201,178,0.4); backdrop-filter:blur(6px);">
            <span id="cameraStatusDot" style="width:7px; height:7px; background:#38c9b2; border-radius:50%; display:inline-block; box-shadow:0 0 6px #38c9b2; transition:all 0.2s ease;"></span>
            <span id="cameraStatusText">1단계: 전신(정면) 촬영 준비 (MediaPipe)</span>
          </div>

          <!-- 사람 미인식 분석 실패 안내 플로팅 경고창 (미인식 시 화면 상단에 일시 노출) -->
          <div id="personDetectionAlertToast" style="display:none; position:absolute; top:52px; left:14px; right:14px; z-index:10; background:rgba(229,57,53,0.95); color:#ffffff; padding:12px 14px; border-radius:12px; font-size:12.5px; font-weight:700; line-height:1.45; box-shadow:0 6px 20px rgba(0,0,0,0.35); border:1px solid #ff7961; backdrop-filter:blur(8px); animation:fadeInDown 0.25s ease;">
            <div style="display:flex; align-items:flex-start; gap:8px;">
              <span style="font-size:16px; flex-shrink:0;">⚠️</span>
              <div>
                <div style="font-size:13px; font-weight:800; margin-bottom:2px;">분석 실패: 사람이 인식되지 않았습니다.</div>
                <div style="font-size:11.5px; opacity:0.95;">전신이 화면에 나오도록 다시 촬영해 주세요.</div>
              </div>
            </div>
          </div>
        </div>

        <div class="capture-bottom-bar">
          <!-- 3방향 썸네일 스트립 (촬영 완료 상태 및 탭 전환) -->
          <div class="capture-thumb-strip">
            <div class="thumb-slot active" id="thumbSlotFront" data-angle="front" title="전신 (정면)">
              <div class="thumb-preview-box" id="thumbBoxFront">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6e8580" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
              <span class="thumb-label">1. 전신(정면)</span>
            </div>

            <div class="thumb-slot" id="thumbSlotLeft" data-angle="left" title="좌측면">
              <div class="thumb-preview-box" id="thumbBoxLeft">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6e8580" stroke-width="2"><circle cx="12" cy="5" r="3"/><path d="M9 20l3-7 3 7"/><path d="M6 12h12"/></svg>
              </div>
              <span class="thumb-label">2. 좌측면</span>
            </div>

            <div class="thumb-slot" id="thumbSlotRight" data-angle="right" title="우측면">
              <div class="thumb-preview-box" id="thumbBoxRight">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6e8580" stroke-width="2"><circle cx="12" cy="5" r="3"/><path d="M9 20l3-7 3 7"/><path d="M6 12h12"/></svg>
              </div>
              <span class="thumb-label">3. 우측면</span>
            </div>
          </div>

          <p style="font-size:12px; color:#a4b6b1; text-align:center; margin:2px 0 4px 0;" id="captureGuideNotice">
            정면을 응시하고 양팔을 가볍게 벌려 바른 자세로 서주세요.
          </p>

          <!-- ⭐ HTML Media Capture API ⭐ -->
          <input type="file" id="cameraCaptureInput" accept="image/*" capture="environment" style="display:none;">
          <!-- 갤러리 파일 업로드 -->
          <input type="file" id="filePhotoInput" accept="image/*" style="display:none;">

          <!-- 촬영 전 메인 컨트롤 -->
          <div class="capture-controls" id="captureControlsBefore">
            <!-- 갤러리 파일 업로드 -->
            <button class="btn-icon-sq" id="btnUploadGallery" title="앨범에서 사진 불러오기">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
            </button>

            <!-- HTML Media Capture API 직접 촬영 버튼 -->
            <button class="btn-primary" id="btnTriggerCapture" style="flex:1;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                <circle cx="12" cy="13" r="4"/>
              </svg>
              <span id="btnTriggerCaptureText">카메라로 직접 촬영</span>
            </button>

            <!-- 모델 예시 사진 토글 -->
            <button class="btn-icon-sq" id="btnToggleSamplePhoto" title="현재 각도 예시 모델 사진">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
              </svg>
            </button>
          </div>

          <!-- 촬영 완료 후 확인 및 다음 단계 이동 컨트롤 -->
          <div class="capture-controls" id="captureControlsAfter" style="display:none; width:100%; gap:8px;">
            <button class="btn-secondary" id="btnRetakePhotoDirect" style="flex:1; height:48px; border-radius:var(--radius-full); font-size:13.5px; background:rgba(255,255,255,0.12); color:#ffffff; border-color:rgba(255,255,255,0.25);">
              다시 촬영
            </button>
            <button class="btn-primary" id="btnNextAngleOrAnalyze" style="flex:1.8; height:48px; font-size:14px;">
              <span id="btnNextAngleText">다음: 좌측면 촬영하기 &gt;</span>
            </button>
          </div>
        </div>
      </section>

      <!-- ========================================================
           [Step 4] 사전 설문조사 (1단위 신체 스펙 입력)
           ======================================================== -->
      <section class="screen" id="screen-survey">
        <header class="nav-header">
          <button class="btn-back" id="btnBackToCapture" aria-label="뒤로가기">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          </button>
          <span class="header-title">사전 설문조사</span>
          <div style="width:36px;"></div>
        </header>

        <div class="survey-progress-box">
          <div class="progress-meta">
            <span>설문조사 1 / 3</span>
            <span>33%</span>
          </div>
          <div class="progress-track"><div class="progress-fill"></div></div>
        </div>

        <div style="padding:14px 20px 4px 20px;">
          <h2 style="font-size:21px; font-weight:800;">신체 정보를 입력해주세요</h2>
          <p style="font-size:13px; color:var(--text-sub);">AI가 사진과 데이터를 결합하여 정밀 진단합니다.</p>
        </div>

        <div class="survey-body">
          <!-- 1. 기본 정보 (키 1cm 단위, 몸무게 1kg 단위) -->
          <div class="survey-group">
            <div class="survey-label" style="display:flex; align-items:center; gap:6px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary-mint-dark)" stroke-width="2.2" stroke-linecap="round"><line x1="2" y1="12" x2="22" y2="12"/><line x1="6" y1="8" x2="6" y2="16"/><line x1="12" y1="9" x2="12" y2="15"/><line x1="18" y1="8" x2="18" y2="16"/></svg>
              <span>1. 기본 신체 스펙 <small>(1단위 세밀 선택)</small></span>
            </div>
            <div class="form-2col">
              <div class="select-pill" style="position:relative;">
                <select id="surveyHeight">
                  <option value="140">140 cm</option>
                  <option value="141">141 cm</option>
                  <option value="142">142 cm</option>
                  <option value="143">143 cm</option>
                  <option value="144">144 cm</option>
