                </div>
                <span style="font-size:11px; font-weight:700; color:var(--text-main);">전신 (정면)</span>
              </div>

              <!-- 2. 좌측면 -->
              <div style="display:flex; flex-direction:column; align-items:center; gap:6px;">
                <div style="width:100%; height:110px; border-radius:12px; overflow:hidden; background:#182320; border:1.5px solid rgba(56,201,178,0.4); position:relative;" id="reportPhotoBoxLeft">
                  <img id="reportPhotoImgLeft" src="" alt="좌측면" style="width:100%; height:100%; object-fit:cover; display:none;">
                  <div id="reportPhotoPlaceholderLeft" style="width:100%; height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; color:#5f7c76; font-size:11px; font-weight:700;">
